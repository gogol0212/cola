---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
const categoryLabels = { 'medical-policy':'医保政策', 'insurance-selection':'保险选购', claims:'医疗与理赔', health:'健康知识', 'family-planning':'家庭规划' };
export async function getStaticPaths(){
  const entries = await getCollection('knowledge', ({data}) => data.status === 'published' && data.slug !== 'medical-insurance-comparison');
  return entries.map(entry => ({ params:{slug:entry.data.slug}, props:{entry} }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;
---
<BaseLayout title={data.seoTitle} description={data.seoDescription} image={data.coverImage}>
  <article><header><div class="container narrow"><a href="/knowledge/">← 返回保险知识</a><p class="eyebrow">{categoryLabels[data.category]}</p><h1>{data.title}</h1><p class="summary">{data.summary}</p><div class="meta"><span>{data.authorLabel}</span><span>更新于 {data.updatedAt.toISOString().slice(0,10)}</span></div>{data.coverImage&&<img src={data.coverImage} alt="" />}</div></header><div class="container narrow article-body"><Content /></div><footer class="article-notes"><div class="container narrow">{data.sourceText&&<p><b>资料来源：</b>{data.sourceText}</p>}<p><b>阅读说明：</b>{data.disclaimer}</p></div></footer></article>
</BaseLayout>
<style>
  header{padding:76px 0 54px;background:#fff}header a{display:inline-block;margin-bottom:34px;color:var(--color-muted);font-size:.85rem;text-decoration:none}h1{max-width:900px;margin:0;font-size:clamp(2.7rem,6vw,5.5rem);line-height:1.08;letter-spacing:-.055em}.summary{max-width:760px;margin:24px 0;color:var(--color-muted);font-size:1.15rem}.meta{display:flex;gap:18px;color:var(--color-muted);font-size:.8rem}header img{width:100%;margin-top:36px;border-radius:28px}.narrow{max-width:900px}.article-body{padding-top:70px;padding-bottom:90px}.article-body :global(h2){margin:2.2em 0 .7em;font-size:2rem;line-height:1.25}.article-body :global(h3){margin:2em 0 .6em}.article-body :global(p),.article-body :global(li){color:var(--color-muted)}.article-body :global(blockquote){margin:2em 0;padding:20px 24px;border-left:4px solid var(--color-brand);border-radius:0 18px 18px 0;background:rgba(211,202,195,.22)}.article-body :global(img){margin:32px 0;border-radius:22px}.article-notes{padding:36px 0;background:rgba(211,202,195,.2);color:var(--color-muted);font-size:.82rem}.article-notes p{margin:8px 0}@media(max-width:600px){header{padding-top:54px}header img{border-radius:20px}.article-body{padding-top:48px}}
</style>
