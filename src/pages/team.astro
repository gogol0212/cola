---
import BaseLayout from '../layouts/BaseLayout.astro';
import TeamMember from '../components/TeamMember.astro';
import teamData from '../data/team.json';
import siteData from '../data/team-site.json';

const teamMembers = teamData.members;
const h = siteData.hero;
const belief = siteData.belief;
const stats = siteData.stats;
const founder = siteData.founder;
const recognition = siteData.recognition;
const beBest = siteData.beBest;
const entrepreneur = siteData.entrepreneur;
const recruitment = siteData.recruitment;
const cta = siteData.cta;
const process = [
  ['01','认识与倾听','了解家庭结构、生活阶段、现有保障与真正担忧。'],
  ['02','需求梳理','识别保障缺口，明确优先级、预算边界与长期目标。'],
  ['03','方案说明','用可理解的语言呈现选择逻辑、责任差异与限制条件。'],
  ['04','长期服务','持续协助保单检视、理赔沟通和家庭阶段变化后的调整。'],
];
const maxSource = Math.max(...recruitment.sourceChart.items.map(i => parseFloat(i.value)));
const anchors = [
  ['#vision','愿景与优势'],['#founder','创始人'],['#people','团队介绍'],
  ['#plans','人才计划'],['#entrepreneur','企业家计划'],['#data','招募数据'],['#join','加入我们'],
];
---
<BaseLayout title="可乐团队｜专业保险顾问团队" description="了解未来可乐团队的长期主义理念、跨行业专业背景、创始人经历、人才培养计划与 2026 上半年招募数据。">
  <section class="team-hero" id="vision"><div class="container">
    <p class="eyebrow on-dark">{h.eyebrow}</p>
    <h1>{h.headline}</h1>
    <p class="hero-sub">{h.subheadline}</p>
    <div class="hero-tags">{h.tags.map(tag => <span>{tag}</span>)}</div>
  </div></section>

  <nav class="chapter-nav" aria-label="页面章节"><div class="container">{anchors.map(([id,label]) => <a href={id}>{label}</a>)}</div></nav>

  <section class="numbers"><div class="container number-grid">{stats.map(s => <article><b>{s.value}</b><span>{s.label}</span><small>{s.note}</small></article>)}</div></section>

  <section class="section belief"><div class="container belief-grid"><div><p class="eyebrow">{belief.eyebrow}</p><h2 class="section-title">{belief.title}</h2></div><div>{belief.paragraphs.map(p => <p>{p}</p>)}</div></div></section>

  <section class="section founder-band" id="founder"><div class="container founder-grid">
    <img src={founder.image} loading="lazy" width="817" height="1090" alt={`${founder.name}，未来可乐团队创始人`} />
    <div><p class="eyebrow">{founder.eyebrow}</p><h2 class="section-title">{founder.name}</h2><p class="founder-meta">{founder.school} · {founder.role} · {founder.years}</p><p class="founder-tagline">{founder.tagline}</p>
    {founder.paragraphs.map(p => <p class="founder-p">{p}</p>)}
    <div class="founder-highlights">{founder.highlights.map(item => <div class="fh-card"><span>{item.label}</span><b>{item.value}</b></div>)}</div>
    </div>
  </div></section>

  <section class="section members" id="people"><div class="container"><p class="eyebrow">Our People</p><h2 class="section-title">{siteData.members.title}</h2><p class="section-lead">{siteData.members.lead}</p><div class="members-grid">{teamMembers.map((member,index) => <TeamMember {...member} featured={index < 2} />)}</div></div></section>

  <section class="section recognition"><div class="container recognition-grid"><div><p class="eyebrow">{recognition.eyebrow}</p><h2 class="section-title">{recognition.title}</h2><p class="section-lead">{recognition.lead}</p></div><div class="recognition-list">{recognition.items.map(item => <span>{item}</span>)}</div></div></section>

  <section class="section bebest" id="plans"><div class="container">
    <p class="eyebrow">{beBest.eyebrow}</p><h2 class="section-title">{beBest.title}</h2><p class="section-lead">{beBest.subtitle}</p>
    <div class="plan-badge">基础人才计划 · 面向更广泛人群</div>
    <div class="bebest-grid">{beBest.cards.map(card => <article class="bebest-card"><span class="period">{card.period}</span><b>{card.amount}<em>{card.unit}</em></b><p>{card.desc}</p></article>)}</div>
    <div class="plan-conditions"><h3>招募条件</h3><ul>{beBest.conditions.map(c => <li>{c}</li>)}</ul></div>
    <p class="plan-note">{beBest.note}</p>
  </div></section>

  <section class="section entrepreneur" id="entrepreneur"><div class="container">
    <p class="eyebrow on-dark">{entrepreneur.eyebrow}</p><h2 class="section-title">{entrepreneur.title}</h2><p class="section-lead light-lead">{entrepreneur.subtitle}</p>
    <p class="plan-badge light-badge">精英人才计划 · 面向跨行业精英 · 三档定级</p>
    <div class="entrepreneur-grid">{entrepreneur.plans.map(plan => <article class:list={['e-plan',{ featured:plan.featured }]}>
      <header><h3>{plan.name}</h3><span>{plan.subname}</span></header>
      <div class="stipend"><span>专业提升期津贴</span><b>{plan.stipend}<em>{plan.unit}</em></b></div>
      <ul class="targets"><li>首三月创无忧收入可达 <strong>{plan.first3m}</strong></li><li>首十二月目标收入可达 <strong>{plan.first12m}</strong></li></ul>
      <div class="e-conditions"><h4>招募条件</h4><ul>{plan.conditions.map(c => <li>{c}</li>)}</ul></div>
    </article>)}</div>
    {entrepreneur.support && <div class="support-panel"><h3>{entrepreneur.support.title}</h3><div class="support-grid">{entrepreneur.support.blocks.map(block => <div class="support-block"><h4>{block.title}</h4><ul>{block.lines.map(l => <li>{l}</li>)}</ul></div>)}</div><p class="plan-note">{entrepreneur.support.note}</p></div>}
  </div></section>

  <section class="section recruitment" id="data"><div class="container">
    <p class="eyebrow">{recruitment.eyebrow}</p><h2 class="section-title">{recruitment.title}</h2><p class="section-lead">{recruitment.lead}</p>
    <div class="r-hero-stats"><div class="r-stat"><b>{recruitment.applied}</b><span>入职申请</span></div><div class="r-stat brand"><b>{recruitment.joined}</b><span>成功入职</span></div><div class="r-stat"><b>{recruitment.acceptance}</b><span>录用率</span></div></div>
    <div class="r-grid">
      <article class="r-card"><div class="r-card-head"><h3>{recruitment.education.title}</h3><div class="r-big">{recruitment.education.big}<span>{recruitment.education.bigLabel}</span></div></div><ul>{recruitment.education.points.map(p => <li>{p}</li>)}</ul></article>
      <article class="r-card"><div class="r-card-head"><h3>{recruitment.transformation.title}</h3><div class="r-big">{recruitment.transformation.big}<span>{recruitment.transformation.bigLabel}</span></div></div><div class="r-grid2">{recruitment.transformation.grid.map(g => <div class="r-cell"><span>{g.label}</span><b>{g.value}</b></div>)}</div></article>
    </div>
    <div class="r-young"><div class="ry-left"><h3>{recruitment.young.title}</h3><p>{recruitment.young.subtitle}</p><div class="ry-bands">{recruitment.young.ageBands.map(band => <div class="ry-band"><span>{band.label}</span><b>{band.count}</b><em>{band.percent}</em></div>)}</div></div><div class="ry-right">{recruitment.young.metrics.map(m => <div class="ry-metric"><b>{m.value}</b><span>{m.label}</span></div>)}</div></div>
    <div class="r-source"><div class="rs-head"><h3>{recruitment.sourceChart.title}</h3><p>{recruitment.sourceChart.subtitle}</p></div><div class="rs-bars">{recruitment.sourceChart.items.map(item => <div class="rs-bar"><span class="rs-label">{item.label}</span><div class="rs-track"><div class="rs-fill" style={`width:${(parseFloat(item.value)/maxSource)*100}%`}></div></div><span class="rs-value">{item.value}</span></div>)}</div></div>
  </div></section>

  <section class="section process"><div class="container"><p class="eyebrow">Service Process</p><h2 class="section-title">先理解，再建议；<br />签约之后，服务继续。</h2><div class="process-grid">{process.map(([number,title,copy]) => <article><b>{number}</b><h3>{title}</h3><p>{copy}</p></article>)}</div></div></section>

  <section class="section join" id="join"><div class="container join-card"><div><p class="eyebrow">{cta.eyebrow}</p><h2>{cta.title}</h2><p>{cta.text}</p></div><a class="button" href={cta.buttonUrl} target="_blank" rel="noopener noreferrer">{cta.buttonText}</a></div></section>
</BaseLayout>
<style>
  .team-hero { min-height: 640px; display:grid; align-items:end; padding: 110px 0 90px; background: linear-gradient(120deg,rgba(51,61,71,.96),rgba(51,61,71,.74)),url('/assets/images/hero-bg.jpg') center/cover; color:white; }
  .team-hero h1 { margin:0; font-size:clamp(3.2rem,7vw,6rem); line-height:1; letter-spacing:-.05em; }
  .team-hero h1:after { content:''; display:block; width:56px; height:5px; margin:26px 0 0; background:var(--color-olive); }
  .eyebrow.on-dark { color:var(--color-olive); }
  .hero-sub { max-width:620px; margin:26px 0 0; color:rgba(255,255,255,.78); font-size:1.15rem; }
  .hero-tags { display:flex; flex-wrap:wrap; gap:8px; margin-top:28px; }.hero-tags span { padding:8px 14px; border:1px solid rgba(255,255,255,.3); border-radius:999px; font-size:.82rem; }
  .chapter-nav { position:sticky; z-index:30; top:64px; border-top:1px solid var(--color-line); border-bottom:1px solid var(--color-line); background:rgba(255,255,255,.92); backdrop-filter:blur(16px); }
  .chapter-nav .container { display:flex; gap:8px; overflow-x:auto; padding-top:10px; padding-bottom:10px; }
  .chapter-nav a { flex:0 0 auto; padding:8px 13px; border-radius:999px; color:var(--color-muted); font-size:.78rem; font-weight:750; text-decoration:none; }
  .chapter-nav a:hover { background:rgba(165,145,92,.13); color:var(--color-ink); }
  .numbers { background:var(--color-olive); color:white; }.number-grid { display:grid; grid-template-columns:repeat(4,1fr); }.number-grid article { display:grid; padding:32px 5%; border-right:1px solid rgba(255,255,255,.25); }.number-grid article:last-child{border-right:none}.number-grid b{font-size:2rem}.number-grid span{opacity:.92;font-weight:700}.number-grid small{opacity:.62;font-size:.78rem}
  .belief { background:white; }.belief-grid { display:grid; grid-template-columns:1fr 1fr; gap:8vw; align-items:center; }.belief-grid>div:last-child { color:var(--color-muted); font-size:1.08rem; }.belief-grid p+p{margin-top:1.2em}
  .founder-band { background:var(--color-canvas); }.founder-grid { display:grid; grid-template-columns:.7fr 1.3fr; gap:6vw; align-items:start; }.founder-grid img { max-height:540px; width:100%; object-fit:contain; object-position:top; border-radius:var(--radius-md); background:white; border:1px solid var(--color-line); }
  .founder-meta { margin:10px 0 0; color:var(--color-brand); font-weight:750; font-size:.9rem; }
  .founder-tagline { margin:18px 0 0; font-size:1.25rem; font-weight:700; line-height:1.5; }
  .founder-p { margin:14px 0 0; color:var(--color-muted); line-height:1.9; }
  .founder-highlights { display:flex; gap:14px; margin-top:26px; }.fh-card { flex:1; padding:18px 20px; background:white; border:1px solid var(--color-line); border-radius:var(--radius-md); }.fh-card span{display:block;color:var(--color-muted);font-size:.78rem;font-weight:700}.fh-card b{display:block;margin-top:6px;font-size:1.05rem;line-height:1.5}
  .members { background:white; }.members-grid { display:grid; grid-template-columns:repeat(5,1fr); gap:16px; margin-top:48px; }
  .recognition { background:var(--color-canvas); }.recognition-grid { display:grid; grid-template-columns:1fr 1fr; gap:8vw; align-items:center; }.recognition-list { display:grid; grid-template-columns:1fr 1fr; gap:12px; }.recognition-list span { padding:26px 20px; border-left:3px solid var(--color-olive); background:white; font-weight:750; }
  .bebest { background:white; }.plan-badge { display:inline-block; margin:18px 0 0; padding:7px 14px; border-radius:999px; background:rgba(165,145,92,.14); color:var(--color-dark-green); font-size:.78rem; font-weight:800; }
  .bebest-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:18px; margin-top:36px; }.bebest-card { padding:30px; border:1px solid var(--color-line); border-radius:var(--radius-md); background:var(--color-canvas); }.bebest-card .period { display:block; color:var(--color-brand); font-weight:800; font-size:.8rem; }.bebest-card b { display:block; margin:12px 0 8px; font-size:2.6rem; letter-spacing:-.02em; }.bebest-card b em { font-style:normal; font-size:1rem; color:var(--color-muted); }.bebest-card p { color:var(--color-muted); font-size:.9rem; }
  .plan-conditions { margin-top:30px; padding:22px 26px; border:1px solid var(--color-line); border-radius:var(--radius-md); }.plan-conditions h3{margin:0 0 10px;font-size:1rem}.plan-conditions ul { display:flex; flex-wrap:wrap; gap:10px; margin:0; padding:0; list-style:none; }.plan-conditions li { padding:7px 14px; border-radius:999px; background:rgba(211,17,69,.06); color:var(--color-brand); font-size:.82rem; font-weight:750; }
  .plan-note { margin:16px 0 0; color:var(--color-muted); font-size:.76rem; }
  .entrepreneur { background:var(--color-charcoal); color:white; }.light-lead { color:rgba(255,255,255,.7); }.light-badge { background:rgba(255,255,255,.1); color:var(--color-olive); }
  .entrepreneur-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:18px; margin-top:36px; align-items:stretch; }
  .e-plan { display:flex; flex-direction:column; padding:26px; border:1px solid rgba(255,255,255,.14); border-radius:var(--radius-md); background:rgba(255,255,255,.04); }
  .e-plan.featured { border-color:var(--color-brand); background:rgba(255,255,255,.08); box-shadow:0 18px 50px rgba(0,0,0,.3); position:relative; }
  .e-plan.featured:before { content:'重点推荐'; position:absolute; top:14px; right:-1px; padding:5px 14px; background:var(--color-brand); color:white; font-size:.7rem; font-weight:800; border-radius:999px 0 0 999px; }
  .e-plan header h3 { margin:0; font-size:1.5rem; }.e-plan header span { color:var(--color-olive); font-size:.82rem; }
  .stipend { margin:22px 0; padding:18px 0; border-top:1px solid rgba(255,255,255,.12); border-bottom:1px solid rgba(255,255,255,.12); text-align:center; }.stipend span { display:block; color:rgba(255,255,255,.6); font-size:.76rem; }.stipend b { display:block; margin-top:6px; font-size:2.8rem; color:var(--color-brand); }.stipend b em { font-style:normal; font-size:1rem; color:rgba(255,255,255,.7); }
  .targets { margin:0 0 20px; padding:0; list-style:none; }.targets li { padding:6px 0; color:rgba(255,255,255,.82); font-size:.9rem; }.targets li strong { color:var(--color-brand); }
  .e-conditions { padding:16px 18px; border-radius:var(--radius-md); background:rgba(255,255,255,.06); }.e-conditions h4 { margin:0 0 8px; font-size:.8rem; color:var(--color-olive); }.e-conditions ul { margin:0; padding:0; list-style:none; }.e-conditions li { padding:3px 0; font-size:.8rem; color:rgba(255,255,255,.75); }
  .support-panel { margin-top:34px; padding:34px; border:1px solid rgba(255,255,255,.14); border-radius:var(--radius-lg); background:rgba(255,255,255,.03); }.support-panel>h3 { margin:0 0 24px; text-align:center; font-size:1.3rem; }.support-grid { display:grid; grid-template-columns:1fr 1fr; gap:28px; }.support-block h4 { margin:0 0 12px; color:var(--color-olive); font-size:1rem; }.support-block ul { margin:0; padding:0; list-style:none; }.support-block li { padding:6px 0 6px 22px; position:relative; color:rgba(255,255,255,.82); font-size:.92rem; }.support-block li:before { content:''; position:absolute; left:4px; top:14px; width:6px; height:6px; border-radius:50%; background:var(--color-brand); }
  .entrepreneur .plan-note { color:rgba(255,255,255,.5); text-align:center; }
  .recruitment { background:white; }.r-hero-stats { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; margin:34px 0; }.r-stat { padding:26px; text-align:center; border:1px solid var(--color-line); border-radius:var(--radius-md); background:var(--color-canvas); }.r-stat.brand { background:var(--color-brand); color:white; border-color:var(--color-brand); }.r-stat b { display:block; font-size:2.6rem; }.r-stat span { opacity:.8; font-size:.9rem; }
  .r-grid { display:grid; grid-template-columns:1fr 1fr; gap:18px; }.r-card { padding:28px; border:1px solid var(--color-line); border-radius:var(--radius-md); background:var(--color-canvas); }.r-card-head h3 { margin:0 0 16px; font-size:1.2rem; border-left:4px solid var(--color-brand); padding-left:14px; }.r-big { display:flex; align-items:baseline; gap:12px; margin-bottom:16px; }.r-big { font-size:3.4rem; font-weight:800; color:var(--color-brand); line-height:1; }.r-big span { font-size:.9rem; font-weight:600; color:var(--color-muted); }.r-card ul { margin:0; padding:0; list-style:none; }.r-card ul li { padding:7px 0; border-top:1px solid rgba(51,61,71,.09); color:var(--color-muted); font-size:.88rem; }
  .r-grid2 { display:grid; grid-template-columns:1fr 1fr; gap:10px; }.r-cell { padding:14px; border-radius:var(--radius-sm); background:white; text-align:center; }.r-cell span { display:block; color:var(--color-muted); font-size:.76rem; }.r-cell b { font-size:1.15rem; }
  .r-young { margin-top:18px; display:grid; grid-template-columns:1.4fr 1fr; gap:18px; }.ry-left { padding:28px; border-radius:var(--radius-md); background:var(--color-charcoal); color:white; }.ry-left h3 { margin:0 0 6px; font-size:1.2rem; }.ry-left p { margin:0 0 18px; color:rgba(255,255,255,.7); font-size:.9rem; }.ry-bands { display:grid; grid-template-columns:repeat(3,1fr); gap:10px; }.ry-band { padding:14px; text-align:center; border-radius:var(--radius-sm); background:rgba(255,255,255,.08); }.ry-band span { display:block; font-size:.76rem; color:rgba(255,255,255,.6); }.ry-band b { display:block; margin:4px 0; font-size:1.3rem; }.ry-band em { font-style:normal; font-size:.9rem; color:var(--color-olive); }
  .ry-right { display:grid; gap:10px; }.ry-metric { display:grid; place-items:center; padding:22px; border-radius:var(--radius-md); border:1px solid var(--color-line); background:var(--color-canvas); }.ry-metric b { font-size:2rem; color:var(--color-brand); }.ry-metric span { color:var(--color-muted); font-size:.82rem; }
  .r-source { margin-top:18px; padding:28px; border:1px solid var(--color-line); border-radius:var(--radius-md); }.rs-head h3 { margin:0; font-size:1.2rem; }.rs-head p { margin:4px 0 20px; color:var(--color-muted); font-size:.88rem; }.rs-bars { display:grid; gap:12px; }.rs-bar { display:grid; grid-template-columns:110px 1fr 60px; gap:14px; align-items:center; }.rs-label { font-size:.86rem; font-weight:700; }.rs-track { height:14px; border-radius:999px; background:rgba(51,61,71,.08); overflow:hidden; }.rs-fill { height:100%; border-radius:999px; background:linear-gradient(90deg,var(--color-brand),#ff5c80); }.rs-value { font-size:.9rem; font-weight:800; color:var(--color-brand); }
  .process { background:var(--color-charcoal); color:white; }.process-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:1px; margin-top:50px; background:rgba(255,255,255,.13); }.process-grid article { padding:30px; background:var(--color-charcoal); }.process-grid b{color:var(--color-olive)}.process-grid h3{margin:50px 0 8px}.process-grid p{color:rgba(255,255,255,.62);font-size:.9rem}
  .join { background:var(--color-canvas); }.join-card { display:grid; grid-template-columns:1fr auto; gap:40px; align-items:center; padding:clamp(36px,6vw,72px); border-radius:var(--radius-lg); background:white; border:1px solid var(--color-line); }.join h2{margin:0;font-size:clamp(2rem,4vw,3.2rem);line-height:1.12}.join p:not(.eyebrow){max-width:760px;color:var(--color-muted)}
  @media(max-width:1100px){.members-grid{grid-template-columns:repeat(4,1fr)}}
  @media(max-width:980px){.members-grid{grid-template-columns:repeat(3,1fr)}.process-grid{grid-template-columns:1fr 1fr}.entrepreneur-grid,.bebest-grid{grid-template-columns:1fr}.r-grid,.r-young,.support-grid{grid-template-columns:1fr}}
  @media(max-width:720px){.belief-grid,.recognition-grid,.founder-grid,.join-card{grid-template-columns:1fr}.number-grid{grid-template-columns:1fr 1fr}.members-grid{grid-template-columns:1fr 1fr}.join-card .button{justify-self:start}.founder-grid img{max-height:420px}.chapter-nav{top:56px}}
  @media(max-width:480px){.team-hero{min-height:560px}.members-grid{grid-template-columns:1fr}.number-grid article{padding:24px 10px}.number-grid b{font-size:1.6rem}.number-grid span{font-size:.75rem}.r-hero-stats{grid-template-columns:1fr}.rs-bar{grid-template-columns:90px 1fr 50px}}
</style>
