---
import BaseLayout from '../layouts/BaseLayout.astro';
import TeamMember from '../components/TeamMember.astro';
import teamData from '../data/team.json';
import siteData from '../data/team-site.json';

const teamMembers = teamData.members;
const h = siteData.hero;
const belief = siteData.belief;
const services = siteData.services;
const aia = siteData.aia;
const stats = siteData.stats;
const founder = siteData.founder;
const recognition = siteData.recognition;
  const aiaKeyYears = ['1919', '1992', '1998', '2010', '2020', '2021'];
const aiaMilestones = aia.milestones.filter(m => aiaKeyYears.includes(m.year));
const anchors = [
  ['#services','我们如何服务'],['#founder','创始人'],['#people','团队伙伴'],
  ['#aia','友邦平台'],
];
const heroHtml = h.headline.replace(h.headlineAccent, `<em>${h.headlineAccent}</em>`);
const sloganHtml = h.slogan.replace('可乐', '<em>可乐</em>');
---
<BaseLayout title="未来可乐团队｜专业家庭保障与长期财富规划团队" description="未来可乐团队依托友邦人寿湖北分公司，以长期、克制、可靠的服务，帮助家庭在教育、健康、养老、财富与传承上多一份确定与从容。">
  <section class="team-hero" id="vision"><div class="container hero-grid">
    <div class="hero-main">
      <p class="eyebrow on-dark">{h.eyebrow}</p>
      <h1 set:html={heroHtml} />
      <p class="hero-sub">{h.subheadline}</p>
      <div class="hero-slogan"><b set:html={sloganHtml} /><span>{h.sloganEn}</span></div>
      <div class="hero-tags">{h.tags.map(tag => <span>{tag}</span>)}</div>
    </div>
    <div class="hero-media no-select">
      <img src={h.image} loading="lazy" decoding="async" alt="未来可乐团队" draggable="false" />
    </div>
  </div></section>

  <nav class="chapter-nav" aria-label="页面章节"><div class="container">{anchors.map(([id,label]) => <a href={id}>{label}</a>)}</div></nav>

  <section class="numbers"><div class="container number-grid">{stats.map(s => <article><b data-count={s.value} >{s.value}</b><span>{s.label}</span><small>{s.note}</small></article>)}</div></section>

  <section class="section belief reveal"><div class="container belief-grid"><div><p class="eyebrow">{belief.eyebrow}</p><h2 class="section-title">{belief.title}</h2></div><div>{belief.paragraphs.map(p => <p>{p}</p>)}</div></div></section>

  <section class="section services reveal" id="services"><div class="container">
    <header class="services-head"><p class="eyebrow">{services.eyebrow}</p><h2 class="section-title">{services.title}</h2><p class="section-lead">{services.lead}</p></header>
    <div class="services-grid">{services.items.map((item, i) => <article class="service-card"><span class="service-num">{String(i + 1).padStart(2, '0')}</span><h3>{item.title}</h3><p>{item.desc}</p></article>)}</div>
  </div></section>

  <section class="section founder-band reveal" id="founder"><div class="container founder-grid">
    <div class="founder-media no-select">
      <img src={founder.image} loading="lazy" width="817" height="1090" alt={`${founder.name}，未来可乐团队创始人`} decoding="async" draggable="false" />
    </div>
    <div><div class="founder-name-row"><h2 class="section-title">{founder.name}</h2><img class="founder-logo" src="/assets/logo.png" alt="" aria-hidden="true" /></div><p class="founder-meta">{founder.school} · {founder.years} · {founder.role}</p><p class="founder-tagline">{founder.tagline}</p>
    {founder.paragraphs.map(p => <p class="founder-p" set:html={p.replace(/“可乐”/g, '<em class="cola-em">“可乐”</em>')} />)}
    <p class="founder-cola" set:html={founder.cola.replace(/“可乐”/g, '<em class="cola-em">“可乐”</em>')} />
    <div class="founder-highlights">{founder.highlights.map(item => <div class="fh-card"><span>{item.label}</span><b class:list={['fh-value',{ big:item.value === '10年+' }]}>{item.value}</b></div>)}</div>
    </div>
  </div></section>

  <section class="section members reveal" id="people"><div class="container">
    <header class="members-head"><p class="eyebrow">{siteData.members.eyebrow}</p><h2 class="section-title">{siteData.members.title}</h2><p class="section-lead">{siteData.members.lead}</p></header>
    <div class="members-grid">{teamMembers.map(member => <TeamMember {...member} />)}</div>
  </div></section>

  <section class="section recognition reveal"><div class="container recognition-grid"><div><p class="eyebrow">{recognition.eyebrow}</p><h2 class="section-title">{recognition.title}</h2><p class="section-lead">{recognition.lead}</p></div><div class="recognition-list">{recognition.items.map(item => <span>{item}</span>)}</div></div></section>

  <section class="section aia reveal" id="aia"><div class="container">
    <header class="aia-head"><div><p class="eyebrow">{aia.eyebrow}</p><h2 class="section-title">{aia.title}</h2></div><p class="aia-sub">{aia.subtitle}</p></header>
    <div class="aia-track-wrap">
      <div class="aia-track" id="aiaTrack">
        {[...aiaMilestones, ...aiaMilestones].map((m, i) => <article class:list={['aia-slide', { featured: m.featured }]}>
          <div class="aia-media no-select"><img src={m.image} loading="lazy" width="1280" height="800" alt={`${m.year}，${m.title}`} decoding="async" draggable="false" /><span class="aia-year">{m.year}</span>{m.featured && <span class="aia-featured">我们的起点</span>}</div>
          <div class="aia-body"><b>{m.year}</b><h3>{m.title}</h3><p>{m.desc}</p></div>
        </article>)}
      </div>
    </div>
    <div class="aia-progress" aria-hidden="true"><div class="aia-progress-bar" id="aiaProgressBar"></div></div>
    <p class="aia-note">{aia.note}</p>
  </div></section>
</BaseLayout>
<script>
  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
  }, { threshold: 0.05 });
  document.querySelectorAll('.reveal').forEach(el => io.observe(el));

  const counters = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (!e.isIntersecting) return;
      const el = e.target;
      const raw = el.dataset.count || '';
      const match = raw.match(/^([\d.]+)(.*)$/);
      if (!match) return;
      const target = parseFloat(match[1]);
      const suffix = match[2];
      const dur = 1500;
      const start = performance.now();
      const tick = (now) => {
        const p = Math.min((now - start) / dur, 1);
        const eased = 1 - Math.pow(1 - p, 3);
        el.textContent = Math.round(target * eased) + suffix;
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
      counters.unobserve(el);
    });
  }, { threshold: 0.5 });
  document.querySelectorAll('[data-count]').forEach(el => counters.observe(el));

  const aiaWrap = document.querySelector('.aia-track-wrap');
  if (aiaWrap && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let paused = false;
    const speed = 0.7;
    const step = () => {
      if (!paused) {
        const slides = aiaWrap.querySelectorAll('.aia-slide');
        const max = aiaWrap.scrollWidth - aiaWrap.clientWidth;
        if (slides.length > 1 && max > 0) {
          const half = slides[slides.length / 2].offsetLeft;
          aiaWrap.scrollLeft += speed;
          if (aiaWrap.scrollLeft >= half) aiaWrap.scrollLeft -= half;
        }
      }
      requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
    aiaWrap.addEventListener('mouseenter', () => { paused = true; }, { passive: true });
    aiaWrap.addEventListener('mouseleave', () => { paused = false; }, { passive: true });
    aiaWrap.addEventListener('touchstart', () => { paused = true; }, { passive: true });
    aiaWrap.addEventListener('touchend', () => { paused = false; }, { passive: true });
  }
</script>
<style>
  .team-hero { min-height: 620px; display:grid; align-items:end; padding: 130px 0 96px; background: linear-gradient(120deg,rgba(51,61,71,.97),rgba(51,61,71,.8)),url('/assets/images/hero-bg.jpg') center/cover; color:white; }
  .hero-grid { display:grid; grid-template-columns: 1.25fr .9fr; gap: clamp(32px, 6vw, 84px); align-items:end; }
  .team-hero h1 { margin:0; font-size:clamp(2.8rem,6vw,5.2rem); line-height:1.06; letter-spacing:-.04em; font-weight:900; text-wrap:balance; }
  .team-hero h1 :global(em) { font-style:normal; color:var(--color-olive); display:inline-block; }
  .team-hero h1:after { content:''; display:block; width:56px; height:5px; margin:26px 0 0; background:var(--color-olive); }
  .eyebrow.on-dark { color:var(--color-olive); }
  .hero-sub { margin:26px 0 0; max-width:560px; color:rgba(255,255,255,.85); font-size:clamp(1rem,1.8vw,1.22rem); line-height:1.75; text-wrap:balance; }
  .hero-slogan { margin:34px 0 0; padding-top:26px; border-top:1px solid rgba(255,255,255,.22); display:grid; gap:6px; }
  .hero-slogan b { font-size:1.3rem; letter-spacing:.12em; font-weight:700; white-space:nowrap; }
  .hero-slogan b :global(em) { font-style:normal; color:var(--color-olive); font-weight:900; }
  .hero-slogan span { color:rgba(255,255,255,.62); font-size:.8rem; letter-spacing:.14em; text-transform:uppercase; }
  .hero-tags { display:flex; flex-wrap:wrap; gap:8px; margin-top:28px; }.hero-tags span { padding:8px 14px; border:1px solid rgba(255,255,255,.28); border-radius:999px; font-size:.82rem; }
  .hero-media { position:relative; }
  .hero-media:before { content:''; position:absolute; inset:16px -16px -16px 16px; border:2px solid rgba(165,145,92,.5); border-radius:var(--radius-lg); pointer-events:none; }
  .hero-media img { position:relative; width:100%; aspect-ratio: 4/3; object-fit:cover; border-radius:var(--radius-lg); box-shadow:0 30px 80px rgba(0,0,0,.45); }
  .chapter-nav { position:sticky; z-index:30; top:64px; border-top:1px solid var(--color-line); border-bottom:1px solid var(--color-line); background:rgba(255,255,255,.94); backdrop-filter:blur(16px); }
  .chapter-nav .container { display:flex; gap:8px; overflow-x:auto; padding-top:10px; padding-bottom:10px; }
  .chapter-nav a { flex:0 0 auto; padding:8px 13px; border-radius:999px; color:var(--color-muted); font-size:.78rem; font-weight:750; text-decoration:none; }
  .chapter-nav a:hover { background:rgba(165,145,92,.13); color:var(--color-ink); }
  .numbers { background:var(--color-olive); color:white; }.number-grid { display:grid; grid-template-columns:repeat(4,1fr); }.number-grid article { display:grid; padding:34px 5%; border-right:1px solid rgba(255,255,255,.25); }.number-grid article:last-child{border-right:none}.number-grid b{font-size:2rem;letter-spacing:-.02em}.number-grid span{opacity:.94;font-weight:700}.number-grid small{opacity:.62;font-size:.78rem}
  .belief { background:white; }.belief-grid { display:grid; grid-template-columns:1fr 1fr; gap:8vw; align-items:center; }.belief-grid>div:last-child { color:var(--color-muted); font-size:1.08rem; }.belief-grid p+p{margin-top:1.2em}
  .services { background:var(--color-canvas); }.services-head { max-width:680px; }
  .services-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:18px; margin-top:52px; }
  .service-card { padding:30px; border:1px solid var(--color-line); border-radius:var(--radius-md); background:white; transition:transform .35s, box-shadow .35s, border-color .35s; }
  .service-card:hover { transform:translateY(-4px); box-shadow:var(--shadow-card); border-color:rgba(165,145,92,.55); }
  .service-num { color:var(--color-olive); font-size:.82rem; font-weight:800; letter-spacing:.12em; }
  .service-card h3 { margin:16px 0 8px; font-size:1.3rem; }
  .service-card p { margin:0; color:var(--color-muted); font-size:.92rem; line-height:1.8; }
  .aia { background:var(--color-canvas); }.aia-head { display:grid; grid-template-columns:1.2fr 1fr; gap:6vw; align-items:end; }.aia-sub { margin:0; color:var(--color-muted); font-size:1.02rem; line-height:1.85; text-wrap:balance; }
  .aia-track-wrap { margin-top:52px; overflow-x:auto; scrollbar-width:thin; scrollbar-color:rgba(165,145,92,.5) transparent; scrollbar-gutter:stable; }
  .aia-track { display:flex; gap:26px; width:max-content; padding-bottom:8px; }
  .aia-slide { flex:0 0 min(400px, 82vw); overflow:hidden; border:1px solid var(--color-line); border-radius:var(--radius-md); background:white; transition:transform .35s, box-shadow .35s; }
  .aia-slide:hover { transform:translateY(-6px); box-shadow:var(--shadow-card); }
  .aia-media { position:relative; aspect-ratio:16/10; overflow:hidden; background:var(--color-charcoal); }
  .aia-media img { width:100%; height:100%; object-fit:cover; transition:transform .7s cubic-bezier(.2,.7,.3,1); }
  .aia-slide:hover .aia-media img { transform:scale(1.05); }
  .aia-year { position:absolute; top:16px; left:16px; padding:8px 16px; border-radius:999px; background:rgba(51,61,71,.82); color:white; font-size:1.15rem; font-weight:800; letter-spacing:.04em; backdrop-filter:blur(6px); }
  .aia-featured { position:absolute; top:16px; right:16px; padding:8px 16px; border-radius:999px; background:var(--color-brand); color:white; font-size:.82rem; font-weight:800; letter-spacing:.06em; backdrop-filter:blur(6px); }
  .aia-body { padding:26px 26px 30px; }
  .aia-body b { display:block; color:var(--color-brand); font-size:2.6rem; line-height:1; letter-spacing:-.02em; }
  .aia-body h3 { margin:10px 0 8px; font-size:1.28rem; }
  .aia-body p { margin:0; color:var(--color-muted); font-size:.92rem; line-height:1.75; text-wrap:balance; }
  .aia-slide.featured { border-color:var(--color-brand); box-shadow:0 0 0 2px rgba(211,17,69,.14), var(--shadow-card); }
  .aia-progress { margin-top:26px; height:3px; border-radius:999px; background:rgba(51,61,71,.12); overflow:hidden; }
  .aia-progress-bar { height:100%; width:0; background:linear-gradient(90deg,var(--color-olive),var(--color-brand)); }
  .aia-note { margin:14px 0 0; color:var(--color-muted); font-size:.76rem; text-align:center; }
  .founder-band { background:var(--color-canvas); }.founder-grid { display:grid; grid-template-columns:.7fr 1.3fr; gap:6vw; align-items:start; }.founder-media { position:relative; }.founder-media:before { content:''; position:absolute; top:22px; left:-22px; width:100%; height:100%; border:2px solid rgba(165,145,92,.55); border-radius:var(--radius-md); }  .founder-media img { position:relative; max-height:540px; width:100%; object-fit:contain; object-position:top; border-radius:var(--radius-md); background:white; border:1px solid var(--color-line); box-shadow:var(--shadow-card); }
  .founder-name-row { position:relative; }
  .founder-name-row .founder-logo { position:absolute; z-index:2; top:50%; right:0; transform:translateY(-50%); width:140px; opacity:.1; pointer-events:none; }
  .founder-meta { margin:10px 0 0; color:var(--color-olive); font-weight:750; font-size:.9rem; }
  .founder-tagline { margin:18px 0 0; font-size:1.25rem; font-weight:700; line-height:1.5; color:var(--color-charcoal); }
  .founder-p { margin:14px 0 0; color:var(--color-muted); line-height:1.9; }
  .founder-cola { margin:18px 0 0; padding:18px 22px; border-left:3px solid var(--color-olive); background:white; border-radius:0 var(--radius-sm) var(--radius-sm) 0; color:var(--color-charcoal); font-size:.98rem; line-height:1.85; }
  .founder-p :global(.cola-em), .founder-cola :global(.cola-em) { font-style:normal; color:var(--color-olive); font-weight:800; letter-spacing:.02em; }
  .founder-highlights { display:flex; gap:14px; margin-top:26px; }.fh-card { flex:1; padding:18px 20px; background:white; border:1px solid var(--color-line); border-radius:var(--radius-md); }.fh-card span{display:block;color:var(--color-muted);font-size:.78rem;font-weight:700}.fh-card b{display:block;margin-top:6px;font-size:1.05rem;line-height:1.5;color:var(--color-charcoal)}.fh-card b.fh-value.big{font-size:2.6rem;font-weight:900;color:var(--color-olive);line-height:1}
  .members { background:white; }.members-head { max-width:680px; }.members-grid { display:grid; grid-template-columns:repeat(5,1fr); gap:22px; margin-top:52px; }
  .recognition { background:var(--color-canvas); }.recognition-grid { display:grid; grid-template-columns:1fr 1fr; gap:8vw; align-items:center; }.recognition-list { display:grid; grid-template-columns:1fr 1fr; gap:12px; }.recognition-list span { padding:26px 20px; border-left:3px solid var(--color-olive); background:white; font-weight:750; }
  .reveal { opacity:0; transform:translateY(26px); transition:opacity .7s ease, transform .7s cubic-bezier(.2,.7,.3,1); }
  .reveal.in { opacity:1; transform:none; }
  @media(prefers-reduced-motion: reduce) { .reveal { opacity:1; transform:none; transition:none; } }
  @media(max-width:1100px){.members-grid{grid-template-columns:repeat(4,1fr)}}
  @media(max-width:980px){.members-grid{grid-template-columns:repeat(3,1fr)}.services-grid{grid-template-columns:1fr 1fr}.hero-grid{grid-template-columns:1fr;align-items:start}.hero-media{max-width:560px;margin-top:6px;overflow:hidden}.hero-media:before{inset:12px -12px -12px 12px}}
  @media(max-width:720px){.belief-grid,.recognition-grid,.founder-grid{grid-template-columns:1fr}.number-grid{grid-template-columns:1fr 1fr}.members-grid{grid-template-columns:1fr 1fr}.founder-media img{max-height:420px}.chapter-nav{top:56px}.founder-name-row .founder-logo{width:90px}.services-grid{grid-template-columns:1fr}.aia-head{grid-template-columns:1fr;gap:18px}.aia-slide{flex-basis:82vw}.aia-media{aspect-ratio:16/10}}
  @media(max-width:480px){.team-hero{min-height:auto;padding:96px 0 72px}.team-hero h1{font-size:2.6rem}.members-grid{grid-template-columns:1fr}.number-grid article{padding:24px 10px}.number-grid b{font-size:1.6rem}.number-grid span{font-size:.75rem}}
</style>
