---
import BaseLayout from '../layouts/BaseLayout.astro';
import joinData from '../data/join.json';
import siteData from '../data/team-site.json';

const hero = joinData.hero;
const intro = joinData.intro;
const offer = joinData.offer;
const culture = joinData.culture;
const path = joinData.path;
const cta = joinData.cta;
const beBest = siteData.beBest;
const entrepreneur = siteData.entrepreneur;
const recruitment = siteData.recruitment;
const maxSource = Math.max(...recruitment.sourceChart.items.map(i => parseFloat(i.value)));
---
<BaseLayout title="加入未来可乐团队｜长期主义者的同行之路" description="加入未来可乐团队。我们寻找的不是短期销售，而是愿意长期学习、持续成长、认真服务客户的专业伙伴。职业交流。">
  <section class="join-hero"><div class="container hero-inner">
    <p class="eyebrow on-dark">{hero.eyebrow}</p>
    <h1>{hero.title}</h1>
    <p class="hero-slogan">{hero.slogan}</p>
    <p class="hero-sub">{hero.subtitle}</p>
    <a class="button" href={hero.ctaUrl}>{hero.ctaText}<span class="btn-arrow">→</span></a>
  </div></section>

  <section class="section intro reveal"><div class="container">
    <header class="block-head"><p class="eyebrow">{intro.eyebrow}</p><h2 class="section-title">{intro.title}</h2><p class="section-lead">{intro.lead}</p></header>
    <div class="fit-grid">{intro.fitItems.map(item => <div class="fit-card"><span class="fit-check">✓</span><p>{item}</p></div>)}</div>
  </div></section>

  <section class="section offer reveal"><div class="container">
    <header class="block-head"><p class="eyebrow">{offer.eyebrow}</p><h2 class="section-title">{offer.title}</h2><p class="section-lead">{offer.lead}</p></header>
    <div class="offer-grid">{offer.items.map(item => <article class="offer-card"><h3>{item.title}</h3><p>{item.desc}</p></article>)}</div>

    <div class="bebest">
      <p class="policy-eyebrow">{beBest.eyebrow}</p>
      <h3>{beBest.title}</h3>
      <p class="policy-sub">{beBest.subtitle}</p>
      <div class="bebest-grid">{beBest.cards.map(card => <article class="bebest-card"><span class="period">{card.period}</span><b>{card.amount}<em>{card.unit}</em></b><p>{card.desc}</p></article>)}</div>
      <div class="policy-conditions"><h4>招募条件</h4><ul>{beBest.conditions.map(c => <li>{c}</li>)}</ul></div>
      <p class="policy-note">{beBest.note}</p>
    </div>

    <div class="entrepreneur-panel">
      <p class="policy-eyebrow">{entrepreneur.eyebrow}</p>
      <h3>{entrepreneur.title}</h3>
      <p class="policy-sub">{entrepreneur.subtitle}</p>
      <div class="eplans-grid">{entrepreneur.plans.map(plan => <article class:list={['eplan', { featured: plan.featured }]}>
        <header><h4>{plan.name}</h4><span>{plan.subname}</span></header>
        <div class="first12m"><span>首十二月目标收入</span><b>{plan.first12m}</b></div>
        <div class="stipend"><span>专业提升期津贴</span><b>{plan.stipend}<em>{plan.unit}</em></b></div>
        <ul class="targets"><li>首三月创无忧收入可达 <strong>{plan.first3m}</strong></li></ul>
        <div class="e-conditions"><h4>招募条件</h4><ul>{plan.conditions.map(c => <li>{c}</li>)}</ul></div>
      </article>)}</div>
      {entrepreneur.support && <div class="support-panel"><h4>{entrepreneur.support.title}</h4><div class="support-grid">{entrepreneur.support.blocks.map(block => <div class="support-block"><b>{block.title}</b><ul>{block.lines.map(l => <li>{l}</li>)}</ul></div>)}</div><p class="policy-note">{entrepreneur.support.note}</p></div>}
    </div>
  </div></section>

  <section class="section culture reveal"><div class="container">
    <header class="block-head"><p class="eyebrow">{culture.eyebrow}</p><h2 class="section-title">{culture.title}</h2></header>
    <blockquote class="culture-quote">{culture.quote}</blockquote>
    <div class="culture-grid">{culture.items.map(item => <div class="culture-item">{item}</div>)}</div>
  </div></section>

  <section class="section path reveal"><div class="container">
    <header class="block-head"><p class="eyebrow">{path.eyebrow}</p><h2 class="section-title">{path.title}</h2></header>
    <div class="path-list">{path.steps.map(step => <div class="path-step"><span class="path-num">{step.num}</span><div><h3>{step.title}</h3><p>{step.desc}</p></div></div>)}</div>
  </div></section>

  <section class="section recruitment reveal" id="data"><div class="container">
    <p class="eyebrow">{recruitment.eyebrow}</p><h2 class="section-title">{recruitment.title}</h2><p class="section-lead">{recruitment.lead}</p>
    <div class="r-hero-stats">
      <div class="r-stat"><b data-count={recruitment.applied}>{recruitment.applied}</b><span>入职申请</span></div>
      <div class="r-stat brand"><b data-count={recruitment.joined}>{recruitment.joined}</b><span>成功入职</span></div>
      <div class="r-stat"><b data-count={recruitment.acceptance}>{recruitment.acceptance}</b><span>录用率</span></div>
    </div>
    <div class="r-grid">
      <article class="r-card"><div class="r-card-head"><h3>{recruitment.education.title}</h3><div class="r-big"><span data-count={recruitment.education.big}>{recruitment.education.big}</span><em>{recruitment.education.bigLabel}</em></div></div><ul>{recruitment.education.points.map(p => <li>{p}</li>)}</ul></article>
      <article class="r-card"><div class="r-card-head"><h3>{recruitment.transformation.title}</h3><div class="r-big"><span data-count={recruitment.transformation.big}>{recruitment.transformation.big}</span><em>{recruitment.transformation.bigLabel}</em></div></div><div class="r-grid2">{recruitment.transformation.grid.map(g => <div class="r-cell"><span>{g.label}</span><b data-count={g.value}>{g.value}</b></div>)}</div></article>
    </div>
    <div class="r-young"><div class="ry-left"><h3>{recruitment.young.title}</h3><p>{recruitment.young.subtitle}</p><div class="ry-bands">{recruitment.young.ageBands.map(band => <div class="ry-band"><span>{band.label}</span><b data-count={band.count}>{band.count}</b><em>{band.percent}</em></div>)}</div></div><div class="ry-right">{recruitment.young.metrics.map(m => <div class="ry-metric"><b data-count={m.value}>{m.value}</b><span>{m.label}</span></div>)}</div></div>
    <div class="r-source"><div class="rs-head"><h3>{recruitment.sourceChart.title}</h3><p>{recruitment.sourceChart.subtitle}</p></div><div class="rs-bars">{recruitment.sourceChart.items.map(item => <div class="rs-bar" style={`--w:${(parseFloat(item.value)/maxSource)*100}%`}><span class="rs-label">{item.label}</span><div class="rs-track"><div class="rs-fill"></div></div><span class="rs-value">{item.value}</span></div>)}</div></div>
  </div></section>

  <section class="section contact-band reveal" id="join-form"><div class="container">
    <div class="contact-head">
      <p class="eyebrow">{cta.eyebrow}</p>
      <h2 class="section-title">{cta.title}</h2>
      <p class="contact-text">{cta.text}</p>
    </div>
    <div class="join-form">
      <iframe src="https://forms.cloud.microsoft/pages/responsepage.aspx?id=DQSIkWdsW0yxEjajBLZtrQAAAAAAAAAAAAZ__isfECBUQktESjZNVFAzTUZOSVdFTjZDVlg2U0tEWC4u&embed=true" width="100%" height="780" frameborder="0" marginwidth="0" marginheight="0" allowfullscreen title="加入未来可乐团队 - 报名表单"></iframe>
    </div>
  </div></section>
</BaseLayout>
<script>
  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
  }, { threshold: 0.15 });
  document.querySelectorAll('.reveal').forEach(el => io.observe(el));

  const counters = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (!e.isIntersecting) return;
      const el = e.target as HTMLElement;
      const raw = el.dataset.count || '';
      const match = raw.match(/^([\d.]+)(.*)$/);
      if (match) {
        const target = parseFloat(match[1]);
        const suffix = match[2];
        const dur = 1500;
        const start = performance.now();
        const tick = (now: number) => {
          const p = Math.min((now - start) / dur, 1);
          const eased = 1 - Math.pow(1 - p, 3);
          el.textContent = Math.round(target * eased) + suffix;
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }
      counters.unobserve(el);
    });
  }, { threshold: 0.5 });
  document.querySelectorAll('[data-count]').forEach(el => counters.observe(el));

  const bars = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); bars.unobserve(e.target); } });
  }, { threshold: 0.4 });
  document.querySelectorAll('.rs-bar').forEach(el => bars.observe(el));
</script>
<style>
  .join-hero { min-height: 560px; display:grid; align-items:center; padding: 130px 0 96px; background: linear-gradient(120deg,rgba(51,61,71,.97),rgba(51,61,71,.82)),url('/assets/images/hero-bg.jpg') center/cover; color:white; }
  .hero-inner { max-width: 760px; }
  .join-hero h1 { margin:0; font-size:clamp(2.8rem,6vw,5rem); line-height:1.06; letter-spacing:-.04em; font-weight:900; text-wrap:balance; }
  .join-hero h1:after { content:''; display:block; width:56px; height:5px; margin:26px 0 0; background:var(--color-olive); }
  .hero-slogan { margin:28px 0 0; font-size:clamp(1.2rem,2.4vw,1.6rem); font-weight:750; line-height:1.5; color:var(--color-olive); }
  .hero-sub { margin:18px 0 34px; max-width:600px; color:rgba(255,255,255,.82); font-size:1.06rem; line-height:1.8; text-wrap:balance; }
  .btn-arrow { transition:transform .25s; }.join-hero .button:hover .btn-arrow { transform:translateX(5px); }
  .intro { background:var(--color-canvas); }
  .offer { background:white; }
  .culture { background:var(--color-charcoal); color:white; }
  .path { background:var(--color-canvas); }
  .block-head { max-width:680px; }
  .block-head .section-lead { color:var(--color-muted); }
  .fit-grid { display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-top:48px; }
  .fit-card { display:flex; align-items:flex-start; gap:14px; padding:22px 24px; border:1px solid var(--color-line); border-radius:var(--radius-md); background:white; }
  .fit-check { flex:0 0 auto; display:grid; place-items:center; width:26px; height:26px; border-radius:50%; background:var(--color-olive); color:white; font-size:.9rem; font-weight:800; }
  .fit-card p { margin:0; font-size:.95rem; line-height:1.6; }
  .offer-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:18px; margin-top:48px; }
  .offer-card { padding:28px; border:1px solid var(--color-line); border-radius:var(--radius-md); background:var(--color-canvas); transition:transform .35s, box-shadow .35s; }
  .offer-card:hover { transform:translateY(-4px); box-shadow:var(--shadow-card); }
  .offer-card h3 { margin:0 0 8px; font-size:1.18rem; }
  .offer-card p { margin:0; color:var(--color-muted); font-size:.9rem; line-height:1.7; }
  .bebest, .entrepreneur-panel { margin-top:52px; padding:clamp(26px,4vw,40px); border:1px solid var(--color-line); border-radius:var(--radius-lg); background:var(--color-canvas); }
  .bebest h3, .entrepreneur-panel h3 { margin:0; font-size:1.5rem; }
  .policy-eyebrow { margin:0 0 8px; color:var(--color-brand); font-size:.76rem; font-weight:800; letter-spacing:.14em; text-transform:uppercase; }
  .policy-sub { margin:8px 0 0; color:var(--color-muted); font-size:.94rem; }
  .bebest-grid, .eplans-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:18px; margin-top:30px; }
  .bebest-card, .eplan { padding:26px; border:1px solid var(--color-line); border-radius:var(--radius-md); background:white; transition:transform .35s, box-shadow .35s, border-color .35s; }
  .bebest-card:hover, .eplan:hover { transform:translateY(-4px); box-shadow:var(--shadow-card); }
  .bebest-card .period { display:block; color:var(--color-brand); font-weight:800; font-size:.8rem; }
  .bebest-card b { display:block; margin:12px 0 8px; font-size:2.6rem; letter-spacing:-.02em; }
  .bebest-card b em, .eplan .stipend b em { font-style:normal; font-size:1rem; color:var(--color-muted); }
  .bebest-card p { margin:0; color:var(--color-muted); font-size:.88rem; line-height:1.7; }
  .policy-conditions { margin-top:22px; }
  .policy-conditions h4, .e-conditions h4 { margin:0 0 10px; font-size:.86rem; }
  .policy-conditions ul, .e-conditions ul { display:flex; flex-wrap:wrap; gap:10px; margin:0; padding:0; list-style:none; }
  .policy-conditions li { padding:7px 14px; border-radius:999px; background:rgba(211,17,69,.06); color:var(--color-brand); font-size:.82rem; font-weight:750; }
  .policy-note { margin:14px 0 0; color:var(--color-muted); font-size:.76rem; line-height:1.7; }
  .eplan.featured { border-color:var(--color-brand); box-shadow:0 0 0 2px rgba(211,17,69,.12), var(--shadow-card); position:relative; }
  .eplan.featured:before { content:'重点推荐'; position:absolute; top:14px; right:-1px; padding:5px 14px; background:var(--color-olive); color:white; font-size:.7rem; font-weight:800; border-radius:999px 0 0 999px; }
  .eplan header h4 { margin:0; font-size:1.3rem; }
  .eplan header span { color:var(--color-olive); font-size:.82rem; }
  .eplan .first12m { margin:18px 0 8px; padding:18px 0; border-top:1px solid rgba(51,61,71,.1); border-bottom:1px solid rgba(51,61,71,.1); text-align:center; background:rgba(211,17,69,.05); border-radius:var(--radius-sm); }
  .eplan .first12m span { display:block; color:var(--color-muted); font-size:.78rem; }
  .eplan .first12m b { display:block; margin-top:6px; font-size:2.6rem; letter-spacing:-.02em; color:var(--color-brand); }
  .eplan .stipend { margin:14px 0; padding:0 0 6px; border:none; }
  .eplan .stipend span { display:block; color:var(--color-muted); font-size:.76rem; }
  .eplan .stipend b { display:block; margin-top:4px; font-size:1.15rem; color:var(--color-ink); }
  .eplan .targets { margin:0 0 16px; padding:0; list-style:none; }
  .eplan .targets li { padding:5px 0; color:var(--color-muted); font-size:.88rem; }
  .eplan .targets li strong { color:var(--color-brand); font-weight:800; }
  .e-conditions { padding:16px 18px; border-radius:var(--radius-sm); background:var(--color-canvas); }
  .e-conditions li { padding:3px 0; font-size:.82rem; color:var(--color-muted); }
  .support-panel { margin-top:30px; padding:26px; border:1px solid rgba(165,145,92,.4); border-radius:var(--radius-md); background:white; }
  .support-panel>h4 { margin:0 0 20px; font-size:1.1rem; }
  .support-grid { display:grid; grid-template-columns:1fr 1fr; gap:24px; }
  .support-block b { color:var(--color-olive); font-size:.92rem; }
  .support-block ul { margin:8px 0 0; padding:0; list-style:none; }
  .support-block li { padding:4px 0 4px 18px; position:relative; color:var(--color-muted); font-size:.88rem; }
  .support-block li:before { content:''; position:absolute; left:2px; top:13px; width:5px; height:5px; border-radius:50%; background:var(--color-olive); }
  .culture-quote { margin:40px 0 34px; font-size:clamp(1.3rem,2.6vw,1.9rem); font-weight:800; line-height:1.5; letter-spacing:-.01em; color:white; }
  .culture-grid { display:flex; flex-wrap:wrap; gap:10px; }
  .culture-item { padding:10px 18px; border:1px solid rgba(255,255,255,.18); border-radius:999px; color:rgba(255,255,255,.85); font-size:.9rem; }
  .path-list { display:grid; gap:0; margin-top:48px; }
  .path-step { display:grid; grid-template-columns:72px 1fr; gap:22px; padding:22px 4px; border-bottom:1px solid var(--color-line); }
  .path-step:last-child { border-bottom:none; }
  .path-num { color:var(--color-olive); font-size:1.3rem; font-weight:900; letter-spacing:.04em; }
  .path-step h3 { margin:0 0 4px; font-size:1.15rem; }
  .path-step p { margin:0; color:var(--color-muted); font-size:.92rem; }
  .recruitment { background:white; }
  .r-hero-stats { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; margin:34px 0; }
  .r-stat { padding:28px; text-align:center; border:1px solid var(--color-line); border-radius:var(--radius-md); background:var(--color-canvas); transition:transform .3s; }
  .r-stat:hover { transform:translateY(-3px); }
  .r-stat.brand { background:var(--color-brand); color:white; border-color:var(--color-brand); }
  .r-stat b { display:block; font-size:2.6rem; letter-spacing:-.02em; }
  .r-stat span { opacity:.8; font-size:.9rem; }
  .r-grid { display:grid; grid-template-columns:1fr 1fr; gap:18px; }
  .r-card { padding:28px; border:1px solid var(--color-line); border-radius:var(--radius-md); background:var(--color-canvas); }
  .r-card-head h3 { margin:0 0 16px; font-size:1.2rem; border-left:4px solid var(--color-brand); padding-left:14px; }
  .r-big { display:flex; align-items:baseline; gap:12px; margin-bottom:16px; }
  .r-big span { font-size:3.4rem; font-weight:800; color:var(--color-brand); line-height:1; }
  .r-big em { font-style:normal; font-size:.9rem; font-weight:600; color:var(--color-muted); }
  .r-card ul { margin:0; padding:0; list-style:none; }
  .r-card ul li { padding:7px 0; border-top:1px solid rgba(51,61,71,.09); color:var(--color-muted); font-size:.88rem; }
  .r-grid2 { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
  .r-cell { padding:14px; border-radius:var(--radius-sm); background:white; text-align:center; }
  .r-cell span { display:block; color:var(--color-muted); font-size:.76rem; }
  .r-cell b { font-size:1.15rem; }
  .r-young { margin-top:18px; display:grid; grid-template-columns:1.4fr 1fr; gap:18px; }
  .ry-left { padding:28px; border-radius:var(--radius-md); background:var(--color-charcoal); color:white; }
  .ry-left h3 { margin:0 0 6px; font-size:1.2rem; }
  .ry-left p { margin:0 0 18px; color:rgba(255,255,255,.7); font-size:.9rem; }
  .ry-bands { display:grid; grid-template-columns:repeat(3,1fr); gap:10px; }
  .ry-band { padding:14px; text-align:center; border-radius:var(--radius-sm); background:rgba(255,255,255,.08); }
  .ry-band span { display:block; font-size:.76rem; color:rgba(255,255,255,.6); }
  .ry-band b { display:block; margin:4px 0; font-size:1.3rem; }
  .ry-band em { font-style:normal; font-size:.9rem; color:var(--color-olive); }
  .ry-right { display:grid; gap:10px; }
  .ry-metric { display:grid; place-items:center; padding:22px; border-radius:var(--radius-md); border:1px solid var(--color-line); background:var(--color-canvas); }
  .ry-metric b { font-size:2rem; color:var(--color-brand); }
  .ry-metric span { color:var(--color-muted); font-size:.82rem; }
  .r-source { margin-top:18px; padding:28px; border:1px solid var(--color-line); border-radius:var(--radius-md); }
  .rs-head h3 { margin:0; font-size:1.2rem; }
  .rs-head p { margin:4px 0 20px; color:var(--color-muted); font-size:.88rem; }
  .rs-bars { display:grid; gap:12px; }
  .rs-bar { display:grid; grid-template-columns:110px 1fr 60px; gap:14px; align-items:center; }
  .rs-label { font-size:.86rem; font-weight:700; }
  .rs-track { height:14px; border-radius:999px; background:rgba(51,61,71,.08); overflow:hidden; }
  .rs-fill { height:100%; width:0; border-radius:999px; background:linear-gradient(90deg,var(--color-brand),var(--color-brand-dark)); transition:width 1.1s cubic-bezier(.2,.7,.3,1); }
  .rs-bar.in .rs-fill { width:var(--w); }
  .rs-value { font-size:.9rem; font-weight:800; color:var(--color-brand); }
  .contact-band { background:white; padding-bottom:40px; }
  .contact-head { text-align:center; max-width:720px; margin:0 auto clamp(28px,4vw,44px); }
  .contact-head h2 { margin-bottom:16px; }
  .contact-text { margin:0; color:var(--color-muted); font-size:1.02rem; line-height:1.85; }
  .join-form { width:100%; }
  .join-form iframe { display:block; width:100%; min-width:min(100%,640px); border:1px solid var(--color-line); border-radius:var(--radius-md); background:white; box-shadow:var(--shadow-card); }
  .reveal { opacity:0; transform:translateY(26px); transition:opacity .7s ease, transform .7s cubic-bezier(.2,.7,.3,1); }
  .reveal.in { opacity:1; transform:none; }
  @media(prefers-reduced-motion: reduce) { .reveal { opacity:1; transform:none; transition:none; } }
  @media(max-width:900px){.offer-grid{grid-template-columns:1fr 1fr}.bebest-grid,.eplans-grid{grid-template-columns:1fr}.r-grid,.r-young{grid-template-columns:1fr}}
  @media(max-width:720px){.join-hero{min-height:auto;padding:96px 0 72px}.join-hero h1{font-size:2.6rem}.fit-grid{grid-template-columns:1fr}.offer-grid{grid-template-columns:1fr}.support-grid{grid-template-columns:1fr}.path-step{grid-template-columns:56px 1fr}.r-hero-stats{grid-template-columns:1fr}.ry-bands{grid-template-columns:1fr}}
  @media(max-width:480px){.rs-bar{grid-template-columns:90px 1fr 50px}}
</style>
