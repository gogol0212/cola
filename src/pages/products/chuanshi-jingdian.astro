          ["友邦传世经典乐享 2026 终身寿险（分红型）", "出生满 7 天–65 周岁", "终身"],
          ["友邦附加经典 2025 定期寿险", "18 周岁–65 周岁", "20 年 / 30 年 / 至 65 周岁"],
        ],
        note: "除附加险外，所有主险均可单独购买，具体请咨询友邦人寿当地机构。",
      },
      {
        title: "身故 / 全残保险金给付口径",
        chips: [
          { label: "给付", value: "max(…)＋红利" },
          { label: "比例", value: "140% / 120%" },
        ],
        headers: ["给付项目", "规则说明"],
        rows: [
          ["基本保额", "合同载明的基本保险金额"],
          ["保证现金价值", "按合同保证现金价值表确定"],
          ["累计已交保费 × 比例", "41–60 岁 140%；61 岁及以上 120%"],
          ["增额红利", "以增加身故保险金的形式给付（非保证）"],
          [
            "给付公式",
            {
              text: "max（基本保额、保证现金价值、累计已交保费 × 对应比例）＋ 增额红利",
              tone: "olive",
            },
          ],
        ],
        note: "身故保险金与全残保险金，公司仅给付其中一项、并以一次为限；给付比例以正式保险合同为准。",
      },
      {
        title: "投保示例 · 情况一｜终身保障（35 岁男性 · 100 万保额 · 20 年交）",
        chips: [
          { label: "64 岁红利演示", value: "229万", tone: "brand" },
          { label: "保证口径", value: "200万", tone: "olive" },
        ],
        headers: ["年龄", "主险·红利演示身故金", "＋附加定期寿险", "合计总身故保险金", "保证口径"],
        rows: [
          ["54 岁", "114 万", "100 万", "214 万", "200 万"],
          ["64 岁", "129 万", "100 万", { text: "229 万", tone: "brand" }, "200 万"],
          ["75 岁", "147 万", "100 万", "247 万", "200 万"],
          ["85 岁", "166 万", "100 万", "266 万", "200 万"],
          ["104 岁", "208 万", "100 万", "308 万", "200 万"],
        ],
        note: "如被保险人在 64 周岁不幸身故，红利演示下家人合计可得约 229 万元总身故保险金（保证利益演示约 200 万元）。",
      },
      {
        title: "投保示例 · 情况二｜富足享老（现金价值）",
        chips: [{ label: "65 岁红利演示现价", value: "92万", tone: "olive" }],
        headers: ["年龄", "累计总保费", "保证利益演示（现金价值）", "红利利益演示（现金价值）"],
        rows: [
          ["54 周岁", "58.0 万", "60 万", "69 万"],
          ["65 周岁", "71 万", "71 万", "92 万"],
          ["80 周岁", "85 万", "85 万", "132 万"],
          ["100 周岁", "96 万", "96 万", "190 万"],
