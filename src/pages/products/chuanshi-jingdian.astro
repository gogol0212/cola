  },
];

const faqs = [
  {
    question: "分红是保证的吗？",
    answer:
      "不是。分红（含增额红利）为非保证利益，某些年度红利可能为零。写进合同的基本保额、保证现金价值与保证给付比例才是确定利益。页面演示基于公司精算假设，不代表未来实际收益，以保险合同与公司披露为准。",
  },
  {
    question: "责任免除只有三项意味着什么？",
    answer:
      "意味着不赔的情形相对更少，但并非没有。主险与附加险的三项免责主要涉及投保人故意行为、被保险人故意犯罪／抗拒刑事强制措施、以及故意自伤或合同成立 2 年内自杀等。所有情形仍以保险合同条款为准。",
  },
  {
    question: "早期退保会有损失吗？",
