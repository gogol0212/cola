---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductHero from "../../components/products/ProductHero.astro";
import ProductFeatures from "../../components/products/ProductFeatures.astro";
import CoverageOverview from "../../components/products/CoverageOverview.astro";
import CompareTable from "../../components/products/CompareTable.astro";
import CaseStudy from "../../components/products/CaseStudy.astro";
import KnowledgeBlock from "../../components/products/KnowledgeBlock.astro";
import FAQ from "../../components/products/FAQ.astro";
import QRCodeBox from "../../components/products/QRCodeBox.astro";
import ProductMeta from "../../components/products/ProductMeta.astro";
import { getCollection } from "astro:content";

const [productEntry] = await getCollection(
  "products",
  ({ data }) => data.slug === "chuanshi-jingdian",
);
const productImage = productEntry?.data.image || "/assets/images/hero-bg.jpg";
const productImagePosition = productEntry?.data.imagePosition || "center";
const productMobileImagePosition = productEntry?.data.mobileImagePosition;
const productDisplayMode = productEntry?.data.displayMode;

const heroTitle = productEntry?.data.title || "传世经典乐享2026";
const heroSummary =
  productEntry?.data.summary ||
  "分红型增额终身寿，确定的基本保额 + 非保证的增额红利，兼顾身故／全残保障与长期现金价值。";
const pageTitle =
  productEntry?.data.seoTitle || "友邦传世经典乐享2026终身寿险（分红型）保障说明｜方仲达";
const pageDescription =
  productEntry?.data.seoDescription ||
  "从增额红利、责任免除、身故／全残保险金与现金价值出发，理解传世经典乐享2026的传承逻辑与利益演示口径。";

const audience = productEntry?.data.audience || [
  "关注家庭长期财富传承与确定保额的人",
  "希望保障金额有机会随分红增长的高净值客户",
  "经营企业、重视责任免除条款与定向传承安排的家庭支柱",
];
const outline = [
  { label: "保障方向", value: "增额终身寿 · 分红型" },
  { label: "给付口径", value: "身故 / 全残" },
  { label: "阅读重点", value: "增额红利、责任免除、现金价值" },
];

const features = [
  {
    eyebrow: "01 · 终身守护",
    title: "终身守护 指定传承",
    text: "一份终身的寿险保障与财富规划，保额与现金价值长期有效；可通过指定受益人的方式，把身故保险金定向给到想给的人。",
  },
  {
    eyebrow: "02 · 增额红利",
    title: "增额红利 高额保障",
    text: "享有友邦增额红利（分红型），保额有机会随红利逐年增长，长期提升身故／全残保障与现金价值；红利为非保证利益。",
  },
  {
    eyebrow: "03 · 按需定制",
    title: "按需定制 乐享未来",
    text: "可搭配附加经典 2025 定期寿险，并可选附加万全如意 A 款豁免保费重大疾病保险，构建多样化、个性化的生命保障地图。",
  },
  {
    eyebrow: "04 · 三项免责",
    title: "三项免责 至诚至信",
    text: "本产品计划主险与附加经典 2025 定期寿险的责任免除均为三项，切实保障客户利益；条款中其他免除保险公司责任的约定，详见条款加粗内容。",
  },
  {
    eyebrow: "05 · 老少同享",
    title: "投保年龄宽 老少同享",
    text: "主险投保年龄为出生满 7 天至 65 周岁，附加经典 2025 定期寿险为 18 周岁至 65 周岁，涵盖范围宽。",
  },
];

type Chip = { label: string; value: string; tone?: "brand" | "olive" };
type Group = {
  title: string;
  chips: Chip[];
  headers: string[];
  rows: (
    | string
    | { text: string; tone?: "brand" | "olive"; muted?: boolean }
  )[][];
  note?: string;
};
type Tab = {
  id: string;
  tab: string;
  heading: string;
  intro?: string;
  groups: Group[];
  footnotes?: string[];
};

const coverageMeta: Chip[] = [
  { label: "投保年龄", value: "主险 7天–65周岁" },
  { label: "保险期间", value: "终身" },
  { label: "产品组成", value: "终身寿＋附加定期寿" },
  { label: "给付口径", value: "身故 / 全残" },
  { label: "责任免除", value: "三项" },
];
const coverageTabs: Tab[] = [
  {
    id: "elements",
    tab: "产品要素与保障责任",
    heading: "产品要素与保障责任",
    intro:
      "先看产品要素与投保说明，再看身故／全残给付口径、官方投保示例与利益演示。所有金额均为演示口径，实际以正式建议书与保险合同为准。",
    groups: [
      {
        title: "产品要素（示例：35 岁男性 · 100 万保额 · 20 年交）",
        chips: [
          { label: "示例保额", value: "100万" },
          { label: "示例缴费", value: "20年交" },
          { label: "保险期间", value: "终身", tone: "olive" },
        ],
        headers: ["要素", "说明"],
        rows: [
          [
            "产品名称",
            "友邦传世经典乐享 2026 终身寿险（分红型）；产品计划另含《友邦附加经典 2025 定期寿险》",
          ],
          ["投保年龄", "主险 出生满 7 天–65 周岁；附加经典 2025 定期寿险 18–65 周岁"],
          ["保险期间", "主险终身；附加定期寿险 20 年 / 30 年 / 至 65 周岁"],
          ["示例保额", "主险与附加险各 100 万元"],
          ["示例缴费", "20 年交：主险年交 29,000 元 + 附加险年交 3,170 元，首年保费合计 32,170 元"],
          ["责任免除", { text: "主险与附加险均为三项", tone: "brand" }],
          ["增值服务", "保险金信托服务、私人家医、致成长等"],
        ],
      },
      {
        title: "投保说明",
        chips: [{ label: "可组合", value: "终身寿＋定期寿＋豁免重疾" }],
