        rows: [
          ["1", "35", "2.9 万", "100.0 万", "0.2 万", "100.0 万", "0.2 万"],
          ["5", "39", "14.5 万", "100.9 万", "3.8 万", "100.0 万", "3.4 万"],
          ["10", "44", "29.0 万", "103.5 万", "13.4 万", "100.0 万", "11.6 万"],
          ["20", "54", "58.0 万", "114.0 万", "68.6 万", "100.0 万", "60.2 万"],
          ["26", "60", "58.0 万", "122.5 万", "80.7 万", "100.0 万", "65.9 万"],
          ["36", "70", "58.0 万", "138.1 万", "104.7 万", "100.0 万", "75.8 万"],
          ["46", "80", "58.0 万", "155.8 万", "132.4 万", "100.0 万", "85.0 万"],
          ["56", "90", "58.0 万", "175.9 万", "160.8 万", "100.0 万", "91.4 万"],
          ["66", "100", "58.0 万", "198.6 万", "190.1 万", "100.0 万", "95.7 万"],
          ["70", "104", "58.0 万", "208.4 万", "206.6 万", "100.0 万", "99.1 万"],
        ],
        note: "节选自官方利益演示表，单位为万元；红利为非保证利益，某些年度红利可能为零。完整数据以正式建议书为准。",
      },
    ],
    footnotes: [
      "利益演示基于公司精算及其他假设，不代表公司历史经营业绩，也不代表对未来经营业绩的预期；保单红利分配不确定，在某些年度红利可能为零。",
      "投保年龄、保费、缴费方式、保额上限与核保结果因产品版本、地区与个人情况而异，均以正式保险合同与保险公司审核为准。",
    ],
  },
];

const compareRows = [
  {
    label: "保额是否增长",
    product:
      "是。分红型，通过增额红利让身故保额长期增长；以 500 万保额、5 年缴为例，红利演示 85 岁身故金约 725.7 万",
    market: "市场同类多以固定保额为主，身故金为 500 万，不随分红增长",
  },
  {
    label: "责任免除",
    product: "主险与附加险均为三项（故意行为、故意犯罪／抗拒强制措施、故意自伤及 2 年内自杀等）",
    market: "同类产品多为五项，常另含吸毒、酒后驾驶／无证驾驶等情形",
  },
  {
    label: "长期金额",
    product: "确定基本保额 + 非保证增额红利，长期金额有机会增长",
    market: "确定基本保额，金额固定，不随分红变化",
  },
  {
    label: "公司评级参考",
    product: "友邦人寿 2025Q4 综合偿付能力 335.14%、风险综合评级 AAA",
    market: "不同公司偿付能力与评级各异，需逐项核对公开披露",
  },
];

const cases = [
  {
    kicker: "示例 01 · 增额红利",
    title: "为什么关注「保额会增长」",
    scenario:
      "同为基本保额 100 万的终身寿，一款为固定保额，一款为分红型。以 35 岁男性、20 年交为例，分红型产品的红利演示身故金随年龄递增。",
    analysis:
      "固定保额产品的身故金长期保持不变；分红型产品在确定的基本保额之外，叠加非保证的增额红利，红利演示下主险身故金约由 54 岁的 114 万增长至 104 岁的 208 万。红利不确定，检验的是公司长期经营与历史兑现。（以 100 万主险、20 年交为例）",
  },
  {
    kicker: "示例 02 · 责任免除",
    title: "责任免除条款为什么值得逐条看",
    scenario:
      "企业主家庭常同时关注意外、债务隔离与传承安排，而不同终身寿产品的责任免除项数与范围并不相同。",
    analysis:
      "本产品计划主险与附加险的责任免除均为三项；部分同类产品为五项，并可能把部分极端情形纳入免责。投保前把免责条款与自身职业、生活习惯对齐，能减少未来可能的争议空间。",
  },
  {
    kicker: "示例 03 · 现金价值",
    title: "现金价值与提前退保的关系",
    scenario:
      "长期寿险前期费用较高，现金价值通常需要若干年才逐步接近累计已交保费。",
    analysis:
      "以 35 岁男性、100 万保额、20 年交为例，保证现金价值约由 60 岁的 65.9 万增长至 100 岁的 95.7 万（红利演示口径约 80.7 万至 190.1 万）。若在保单早期退保，可能低于已交保费，应以长期持有作为规划前提。",
  },
];

const knowledgeItems = [
  {
    label: "增额终身寿",
    title: "保额为什么会「长大」",
    text: "分红型增额终身寿把保额增长依托于增额红利：红利以增加保额的方式计入，使身故保险金与现金价值有机会逐年提升，用来对冲长期通胀对传承金额的稀释。",
  },
  {
    label: "分红",
