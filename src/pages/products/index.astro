---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import officialCatalog from '../../data/aia-products.json';

const productLineLabels: Record<string, string> = { health:'健康保障', accident:'意外保障', 'critical-illness':'重疾保障', retirement:'享老保障', wealth:'财富管理', legacy:'传世系列' };
const audienceLabels: Record<string, string> = { adult:'成人', child:'儿童' };
const productLineFilters = [['all','全部类别'], ...Object.entries(productLineLabels)];
const audienceFilters = [['all','全部人群'], ...Object.entries(audienceLabels)];
const products = (await getCollection('products', ({ data }) => data.status !== 'draft')).sort((a,b) => a.data.sortOrder - b.data.sortOrder);
const total = products.length + officialCatalog.products.length;
---
<BaseLayout title="保险产品知识库｜方仲达" description="按友邦官方保障类别和成人、儿童人群筛选保险知识与产品索引。">
  <section class="section library-hero"><div class="container"><p class="eyebrow">Knowledge Library</p><h1 class="section-title">先明确保障需求，<br />再理解适合的人群与工具。</h1><p class="section-lead">产品类别采用友邦官网结构，并增加成人与儿童人群筛选。本站解读用于知识普及，产品名称和公开资料以友邦官网及正式保险合同为准。</p></div></section>

  <section class="section"><div class="container">
    <div class="section-head"><div><p class="eyebrow">Find the right direction</p><h2 class="section-title">按类别与人群筛选</h2></div><span id="result-count" aria-live="polite">{total} 项内容</span></div>
    <div class="filter-group"><span>保障类别</span><div class="filter-bar" role="group" aria-label="保障类别筛选">{productLineFilters.map(([value,label],index) => <button type="button" class:list={['filter-button',{active:index===0}]} data-filter-group="line" data-filter={value} aria-pressed={index===0 ? 'true':'false'}>{label}</button>)}</div></div>
    <div class="filter-group"><span>适用人群</span><div class="filter-bar" role="group" aria-label="适用人群筛选">{audienceFilters.map(([value,label],index) => <button type="button" class:list={['filter-button',{active:index===0}]} data-filter-group="audience" data-filter={value} aria-pressed={index===0 ? 'true':'false'}>{label}</button>)}</div></div>

    <div class="product-grid" id="product-grid">
      {products.map(product => <a class="product-card" data-line={product.data.productLine} data-audiences={product.data.audiences.join(' ')} href={`/products/${product.data.slug}/`}>
        <div class="product-card__image">{product.data.heroImage ? <img src={product.data.heroImage} alt="" /> : <span>{productLineLabels[product.data.productLine]}</span>}</div>
        <div class="product-card__body"><span>本站深度解读</span><h3>{product.data.title}</h3><p>{product.data.summary}</p><div class="tag-list"><em>{productLineLabels[product.data.productLine]}</em>{product.data.audiences.map(audience => <em>{audienceLabels[audience]}</em>)}</div><b>阅读完整指南 →</b></div>
      </a>)}
      {officialCatalog.products.map(product => <a class="product-card official-card" data-line={product.productLine} data-audiences={product.audiences.join(' ')} href={product.officialUrl} target="_blank" rel="noopener noreferrer">
        <div class="product-card__image official-mark"><span>AIA<br />官方资料</span></div>
        <div class="product-card__body"><span>友邦官网产品索引</span><h3>{product.title}</h3><p>{product.summary}</p><div class="tag-list"><em>{productLineLabels[product.productLine]}</em>{product.audiences.map(audience => <em>{audienceLabels[audience]}</em>)}</div><b>前往友邦官网核验 ↗</b></div>
      </a>)}
    </div>
    <p class="empty-state" id="empty-state" hidden>暂未收录同时符合这两个条件的内容，您可以切换筛选或联系我们梳理需求。</p>
    <p class="source-note">官网索引首批同步于 {officialCatalog.updatedAt}。友邦产品可能调整、升级或停售；保险责任、投保条件、利益演示及服务内容均以友邦官网、正式保险合同与最新资料为准。</p>
  </div></section>

  <section class="section category-section"><div class="container"><p class="eyebrow">Official product structure</p><h2 class="section-title">六个保障方向</h2><div class="category-grid">{Object.entries(productLineLabels).map(([key,label],index)=><article><span>0{index+1}</span><h3>{label}</h3><p>{key === 'health' ? '医疗费用、高端医疗与健康服务安排。' : key === 'accident' ? '日常、出行及特定场景的意外风险保障。' : key === 'critical-illness' ? '成人或儿童重大疾病带来的收入与治疗压力。' : key === 'retirement' ? '长寿阶段的养老现金流与服务规划。' : key === 'wealth' ? '长期积累、年金安排与家庭财富规划。' : '高净值家庭的人身保障与财富传承安排。'}</p></article>)}</div></div></section>
</BaseLayout>

<script>
  const state = { line: 'all', audience: 'all' };
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-button');
  const cards = document.querySelectorAll<HTMLElement>('.product-card');
  const count = document.querySelector('#result-count');
  const empty = document.querySelector<HTMLElement>('#empty-state');
  const applyFilters = () => {
    let visible = 0;
    cards.forEach(card => {
      const audiences = (card.dataset.audiences ?? '').split(' ');
      const show = (state.line === 'all' || card.dataset.line === state.line) && (state.audience === 'all' || audiences.includes(state.audience));
      card.hidden = !show;
      if (show) visible++;
    });
    if (count) count.textContent = `${visible} 项内容`;
    if (empty) empty.hidden = visible !== 0;
  };
  buttons.forEach(button => button.addEventListener('click', () => {
    const group = button.dataset.filterGroup as 'line' | 'audience';
    state[group] = button.dataset.filter ?? 'all';
    document.querySelectorAll<HTMLButtonElement>(`.filter-button[data-filter-group="${group}"]`).forEach(item => {
      const active = item === button;
      item.classList.toggle('active', active);
      item.setAttribute('aria-pressed', String(active));
    });
    applyFilters();
  }));
</script>

<style>
  .library-hero{padding-bottom:60px;background:linear-gradient(145deg,#fff,rgba(165,145,92,.15))}.section-head{display:flex;align-items:end;justify-content:space-between;gap:24px}.section-head>span{color:var(--color-muted)}.filter-group{display:grid;grid-template-columns:88px 1fr;align-items:start;gap:18px;margin-top:26px}.filter-group>span{padding-top:10px;color:var(--color-muted);font-size:.86rem;font-weight:800}.filter-bar{display:flex;flex-wrap:wrap;gap:10px}.filter-button{padding:10px 17px;border:1px solid var(--color-line);border-radius:999px;background:white;color:var(--color-ink);font:inherit;font-size:.9rem;font-weight:700;cursor:pointer}.filter-button:hover,.filter-button.active{border-color:var(--color-brand);background:var(--color-brand);color:white}.product-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:24px;margin-top:38px}.product-card{display:grid;grid-template-columns:.72fr 1.28fr;overflow:hidden;border:1px solid var(--color-line);border-radius:var(--radius-md);background:white;text-decoration:none;transition:transform .25s ease,box-shadow .25s ease}.product-card[hidden]{display:none}.product-card:hover{transform:translateY(-4px);box-shadow:var(--shadow-card)}.product-card__image{min-height:280px;background:var(--color-olive);color:white}.product-card__image img{width:100%;height:100%;object-fit:cover}.product-card__image>span{display:grid;height:100%;place-items:center;padding:20px;text-align:center;font-weight:800}.official-mark{background:var(--color-charcoal)}.official-card .product-card__body>span{color:var(--color-olive)}.product-card__body{padding:28px}.product-card__body>span{color:var(--color-brand);font-size:.78rem;font-weight:800}.product-card h3{margin:8px 0;font-size:1.45rem}.product-card p{color:var(--color-muted)}.product-card b{color:var(--color-brand)}.tag-list{display:flex;flex-wrap:wrap;gap:7px;margin:18px 0}.tag-list em{padding:5px 9px;border-radius:999px;background:rgba(165,145,92,.14);color:var(--color-dark-green);font-size:.76rem;font-style:normal;font-weight:750}.empty-state{padding:36px;border:1px dashed var(--color-olive);border-radius:var(--radius-md);color:var(--color-muted);text-align:center}.source-note{margin-top:28px;color:var(--color-muted);font-size:.8rem}.category-section{background:white}.category-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:44px}.category-grid article{padding:28px;border:1px solid var(--color-line);border-radius:var(--radius-md)}.category-grid span{color:var(--color-olive);font-weight:800}.category-grid h3{margin:18px 0 8px}.category-grid p{color:var(--color-muted);font-size:.92rem}@media(max-width:800px){.product-grid,.category-grid{grid-template-columns:1fr}.product-card{grid-template-columns:1fr}.product-card__image{min-height:190px}.section-head{align-items:start;flex-direction:column}.filter-group{grid-template-columns:1fr;gap:8px}.filter-group>span{padding:0}.filter-bar{flex-wrap:nowrap;overflow-x:auto;padding-bottom:8px}.filter-button{flex:0 0 auto}}
</style>
