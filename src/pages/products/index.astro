---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const categoryLabels = { children:'儿童保险', medical:'医疗保险', 'critical-illness':'重疾保险', savings:'储蓄保险', pension:'养老规划', 'overseas-assets':'海外资产配置' };
const needLabels = { health:'健康保障', longevity:'长期规划', wealth:'财富管理', 'accident-medical':'应对意外医疗', 'medical-costs':'补偿医疗费用', 'critical-illness':'储备重疾费用', 'long-term-care':'储备长护费用', 'family-responsibility':'承担家庭责任', 'children-planning':'子女规划准备', retirement:'品质养老准备', 'wealth-management':'积累 · 保全 · 传承' };
const filters = [
  ['all','全部产品'], ['health','健康保障'], ['longevity','长期规划'], ['wealth','财富管理'],
  ['accident-medical','意外医疗'], ['medical-costs','医疗费用'], ['critical-illness','重疾费用'],
  ['family-responsibility','家庭责任'], ['children-planning','子女规划'], ['retirement','品质养老']
];
const products = (await getCollection('products', ({ data }) => data.status !== 'draft')).sort((a,b) => a.data.sortOrder - b.data.sortOrder);
const categories = Object.entries(categoryLabels);
---
<BaseLayout title="保险产品知识库｜方仲达" description="按家庭健康、长期规划与财富管理需求，筛选儿童、医疗、重疾、储蓄和养老保险知识。">
  <section class="section library-hero"><div class="container"><p class="eyebrow">Knowledge Library</p><h1 class="section-title">先找到家庭需求，<br />再理解合适的保障工具。</h1><p class="section-lead">产品标签对应“健康、长久、保财”三层家庭需求。您可以按当前最关心的问题筛选，再进入页面理解责任、案例与选择逻辑。</p></div></section>

  <section class="section"><div class="container">
    <div class="section-head"><div><p class="eyebrow">Find by need</p><h2 class="section-title">按需求筛选产品</h2></div><span id="result-count" aria-live="polite">{products.length} 篇内容</span></div>
    <div class="filter-bar" role="group" aria-label="产品需求筛选">{filters.map(([value,label],index) => <button type="button" class:list={['filter-button',{active:index===0}]} data-filter={value} aria-pressed={index===0 ? 'true':'false'}>{label}</button>)}</div>
    <div class="product-grid" id="product-grid">{products.map(product => {
      const tags = [...product.data.needGroups, ...product.data.needTags];
      return <a class="product-card" data-tags={tags.join(' ')} href={`/products/${product.data.slug}/`}>
        <div class="product-card__image">{product.data.heroImage ? <img src={product.data.heroImage} alt="" /> : <span>{categoryLabels[product.data.category]}</span>}</div>
        <div class="product-card__body"><span>{categoryLabels[product.data.category]}</span><h3>{product.data.title}</h3><p>{product.data.summary}</p><div class="tag-list">{tags.map(tag => <em>{needLabels[tag]}</em>)}</div><b>阅读完整指南 →</b></div>
      </a>;
    })}</div>
    <p class="empty-state" id="empty-state" hidden>这个需求方向的内容正在建设中，您也可以先联系我们进行一对一梳理。</p>
  </div></section>

  <section class="section category-section"><div class="container"><p class="eyebrow">Browse by product type</p><h2 class="section-title">按产品类型浏览</h2><div class="category-grid">{categories.map(([key,label],index)=><article><span>0{index+1}</span><h3>{label}</h3><p>{key === 'children' ? '从成长阶段、意外与医疗支出出发，为孩子补充基础医保之外的风险保障。' : '内容建设中。未来将用统一模板呈现适用人群、责任重点、案例、比较与常见问题。'}</p></article>)}</div></div></section>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-button');
  const cards = document.querySelectorAll<HTMLElement>('.product-card');
  const count = document.querySelector('#result-count');
  const empty = document.querySelector<HTMLElement>('#empty-state');
  buttons.forEach(button => button.addEventListener('click', () => {
    const filter = button.dataset.filter ?? 'all'; let visible = 0;
    buttons.forEach(item => { const active = item === button; item.classList.toggle('active',active); item.setAttribute('aria-pressed',String(active)); });
    cards.forEach(card => { const show = filter === 'all' || (card.dataset.tags ?? '').split(' ').includes(filter); card.hidden = !show; if(show) visible++; });
    if(count) count.textContent = `${visible} 篇内容`; if(empty) empty.hidden = visible !== 0;
  }));
</script>

<style>
  .library-hero{padding-bottom:60px;background:linear-gradient(145deg,#fff,rgba(165,145,92,.15))}.section-head{display:flex;align-items:end;justify-content:space-between;gap:24px}.section-head>span{color:var(--color-muted)}.filter-bar{display:flex;flex-wrap:wrap;gap:10px;margin-top:34px}.filter-button{padding:10px 17px;border:1px solid var(--color-line);border-radius:999px;background:white;color:var(--color-ink);font:inherit;font-size:.9rem;font-weight:700;cursor:pointer}.filter-button:hover,.filter-button.active{border-color:var(--color-brand);background:var(--color-brand);color:white}.product-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:24px;margin-top:32px}.product-card{display:grid;grid-template-columns:.8fr 1.2fr;overflow:hidden;border:1px solid var(--color-line);border-radius:var(--radius-md);background:white;text-decoration:none;transition:transform .25s ease,box-shadow .25s ease}.product-card[hidden]{display:none}.product-card:hover{transform:translateY(-4px);box-shadow:var(--shadow-card)}.product-card__image{min-height:290px;background:var(--color-olive);color:white}.product-card__image img{width:100%;height:100%;object-fit:cover}.product-card__image>span{display:grid;height:100%;place-items:center;font-weight:800}.product-card__body{padding:28px}.product-card__body>span{color:var(--color-brand);font-size:.82rem;font-weight:800}.product-card h3{margin:8px 0;font-size:1.8rem}.product-card p{color:var(--color-muted)}.product-card b{color:var(--color-brand)}.tag-list{display:flex;flex-wrap:wrap;gap:7px;margin:18px 0}.tag-list em{padding:5px 9px;border-radius:999px;background:rgba(165,145,92,.14);color:var(--color-dark-green);font-size:.76rem;font-style:normal;font-weight:750}.empty-state{padding:36px;border:1px dashed var(--color-olive);border-radius:var(--radius-md);color:var(--color-muted);text-align:center}.category-section{background:white}.category-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:44px}.category-grid article{padding:28px;border:1px solid var(--color-line);border-radius:var(--radius-md)}.category-grid span{color:var(--color-olive);font-weight:800}.category-grid h3{margin:18px 0 8px}.category-grid p{color:var(--color-muted);font-size:.92rem}@media(max-width:800px){.product-grid,.category-grid{grid-template-columns:1fr}.product-card{grid-template-columns:1fr}.product-card__image{min-height:220px}.section-head{align-items:start;flex-direction:column}.filter-bar{flex-wrap:nowrap;overflow-x:auto;padding-bottom:8px}.filter-button{flex:0 0 auto}}
</style>
