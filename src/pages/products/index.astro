---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const categoryLabels = {
  children: '儿童保险', medical: '医疗保险', 'critical-illness': '重疾保险',
  savings: '储蓄保险', pension: '养老规划', 'overseas-assets': '海外资产配置'
};
const products = (await getCollection('products', ({ data }) => data.status !== 'draft')).sort((a,b) => a.data.sortOrder - b.data.sortOrder);
const categories = Object.entries(categoryLabels);
---
<BaseLayout title="保险产品知识库｜方仲达" description="以家庭真实需求为入口，理解儿童、医疗、重疾、储蓄、养老与海外资产配置相关保险知识。">
  <section class="section library-hero"><div class="container"><p class="eyebrow">Knowledge Library</p><h1 class="section-title">不是一张产品清单，<br />而是一套家庭保障知识库。</h1><p class="section-lead">从真实生活场景出发，拆解保障责任、免赔额、适用人群与选择逻辑。所有页面采用同一套信息模板，方便长期比较与更新。</p></div></section>
  <section class="section"><div class="container"><div class="section-head"><div><p class="eyebrow">Featured Guides</p><h2 class="section-title">精选产品指南</h2></div><span>{products.length} 篇已审核内容</span></div><div class="product-grid">{products.map(product => <a class="product-card" href={`/products/${product.data.slug}/`}><div class="product-card__image">{product.data.heroImage ? <img src={product.data.heroImage} alt="" /> : <span>{categoryLabels[product.data.category]}</span>}</div><div class="product-card__body"><span>{categoryLabels[product.data.category]}</span><h3>{product.data.title}</h3><p>{product.data.summary}</p><b>阅读完整指南 →</b></div></a>)}</div></div></section>
  <section class="section category-section"><div class="container"><p class="eyebrow">Browse by need</p><h2 class="section-title">按家庭需求浏览</h2><div class="category-grid">{categories.map(([key,label],index)=><article><span>0{index+1}</span><h3>{label}</h3><p>{key === 'children' ? '从成长阶段、意外与医疗支出出发，为孩子补充基础医保之外的风险保障。' : '内容建设中。未来将用统一模板呈现适用人群、责任重点、案例、比较与常见问题。'}</p></article>)}</div></div></section>
</BaseLayout>
<style>.library-hero{padding-bottom:60px;background:linear-gradient(145deg,#fff,rgba(165,145,92,.15))}.section-head{display:flex;align-items:end;justify-content:space-between;gap:24px}.section-head>span{color:var(--color-muted)}.product-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:24px;margin-top:44px}.product-card{display:grid;grid-template-columns:.8fr 1.2fr;overflow:hidden;border:1px solid var(--color-line);border-radius:var(--radius-md);background:white;text-decoration:none;transition:transform .25s ease,box-shadow .25s ease}.product-card:hover{transform:translateY(-4px);box-shadow:var(--shadow-card)}.product-card__image{min-height:290px;background:var(--color-olive);color:white}.product-card__image img{width:100%;height:100%;object-fit:cover}.product-card__image>span{display:grid;height:100%;place-items:center;font-weight:800}.product-card__body{padding:28px}.product-card__body>span{color:var(--color-brand);font-size:.82rem;font-weight:800}.product-card h3{margin:8px 0;font-size:1.8rem}.product-card p{color:var(--color-muted)}.product-card b{color:var(--color-brand)}.category-section{background:white}.category-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:44px}.category-grid article{padding:28px;border:1px solid var(--color-line);border-radius:var(--radius-md)}.category-grid span{color:var(--color-olive);font-weight:800}.category-grid h3{margin:18px 0 8px}.category-grid p{color:var(--color-muted);font-size:.92rem}@media(max-width:800px){.product-grid,.category-grid{grid-template-columns:1fr}.product-card{grid-template-columns:1fr}.product-card__image{min-height:220px}.section-head{align-items:start;flex-direction:column}}</style>
