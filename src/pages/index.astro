---
import BaseLayout from '../layouts/BaseLayout.astro';
import TeamMember from '../components/TeamMember.astro';
import { teamMembers } from '../data/team';
---
<BaseLayout title="方仲达｜专业保险顾问与未来可乐团队" description="方仲达个人品牌网站，依托友邦人寿平台，为中高净值家庭、儿童家庭与海外资产规划客户提供长期保险与风险管理服务。">
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy"><p class="eyebrow">AIA HUBEI · COLA TEAM</p><h1>未来可乐团队</h1><p class="hero-belief">一群专业的人，<br /><em>一起做长期正确的事。</em></p><p class="hero-intro">汇聚跨行业专业伙伴，在友邦人寿的平台上，为家庭提供有温度、可持续的风险保障与财富规划服务。</p><div class="hero-actions"><a class="button" href="/team/">认识可乐团队</a><a class="button secondary" href="/products/">探索保险知识</a></div></div>
    </div>
    <p class="photo-note container">AIA 保险大厦 · 团队真实影像将持续更新</p>
  </section>
  <section class="metrics"><div class="container metric-grid"><div><b>100%</b><span>本科及以上学历</span></div><div><b>80%</b><span>海归 · 985 · 211</span></div><div><b>20+</b><span>跨行业专业伙伴</span></div></div></section>
  <section class="section audiences"><div class="container"><p class="eyebrow">Who We Serve</p><h2 class="section-title">从家庭真实处境出发，<br />不从产品名称出发。</h2><div class="audience-grid"><article><span>01</span><h3>儿童家庭</h3><p>关注成长阶段的医疗、意外与重疾保障，为家庭预算建立清晰优先级。</p></article><article><span>02</span><h3>中高净值家庭</h3><p>统筹健康风险、家庭责任与长期财富目标，避免保障方案彼此割裂。</p></article><article><span>03</span><h3>海外资产规划客户</h3><p>结合跨境生活经验，从长期配置、币种与家庭安排角度梳理需求。</p></article></div></div></section>
  <section class="section founder" id="founder"><div class="container split"><div><p class="eyebrow">About Fang</p><h2 class="section-title">十年海外经历，<br />五年保险实践。</h2></div><div class="story"><p>我拥有十年澳洲留学与工作经历，持续深耕海外投资与资产规划领域。这段跨周期的实践，让我对长期资产配置、风险管理与时间价值有着清醒而务实的理解。</p><p>2021 年友邦人寿进入湖北，我选择跨界加入，成为首批营销员之一。保险不是短期交易，而是陪伴客户穿越不同人生阶段的长期承诺。</p><div class="specialties"><span>医疗保险</span><span>家庭风险规划</span><span>海外资产视角</span></div></div></div></section>
  <section class="section team"><div class="container"><p class="eyebrow">Selected Team</p><h2 class="section-title">专业背景各不相同，<br />长期主义始终一致。</h2><div class="team-grid">{teamMembers.slice(0,4).map((member) => <TeamMember {...member} />)}</div><a class="team-link" href="/team/">查看完整团队介绍 →</a></div></section>
  <section class="section strengths"><div class="container strength-grid"><div><p class="eyebrow">Why Cola</p><h2 class="section-title">专业判断之外，<br />更重视长期关系。</h2></div><div class="strength-list"><article><b>01</b><div><h3>需求先于产品</h3><p>先梳理家庭结构、责任与预算，再讨论具体保障工具。</p></div></article><article><b>02</b><div><h3>跨行业复合视角</h3><p>团队成员来自金融、医疗、教育、互联网与企业经营等领域。</p></div></article><article><b>03</b><div><h3>持续服务与复盘</h3><p>保障不是签约即结束，而是跟随家庭阶段变化持续检视。</p></div></article></div></div></section>
  <section class="section featured-product"><div class="container product-card"><div><p class="eyebrow">Featured Knowledge</p><h2>儿童保障，从看懂一次住院费用开始。</h2><p>友童行现有产品说明页已经整理了医保内外费用、责任范围和真实生活场景，后续将迁移为统一知识库模板。</p><a class="button" href="https://aia.fangzhongda.com/">查看友童行说明</a></div><div class="product-mark"><span>儿童保险</span><strong>友童行</strong><small>知识页迁移准备中</small></div></div></section>
  <section class="section promise"><div class="container"><div class="promise-card"><p class="eyebrow">Our Principle</p><blockquote>“不做最大，做最专业，长期陪伴客户。”</blockquote><p>以客户需求为中心，提供覆盖家庭不同阶段的风险保障与财富规划服务。</p></div></div></section>
</BaseLayout>
<style>
  .hero { position: relative; min-height: 760px; display: grid; align-items: center; overflow: hidden; background-color: #fff; background-image: url('/assets/images/hero-bg.jpg'); background-position: center; background-repeat: no-repeat; background-size: cover; }
  .hero::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(90deg, transparent 38%, rgba(255,255,255,.15) 52%, rgba(255,255,255,.92) 72%); }
  .hero-grid { position: relative; z-index: 1; display: grid; grid-template-columns: 1fr 1fr; align-items: center; min-height: 760px; }
  .hero-copy { grid-column: 2; max-width: 620px; padding: 72px 0 72px clamp(28px,5vw,76px); }
  h1 { margin: 0 0 22px; color: var(--color-charcoal); font-size: clamp(3.5rem, 6.6vw, 6.4rem); line-height: .95; letter-spacing: -.065em; }
  .hero-belief { margin: 0; color: var(--color-charcoal); font-size: clamp(1.65rem,3vw,2.65rem); font-weight: 760; line-height: 1.28; letter-spacing: -.03em; }
  .hero-belief em { color: var(--color-brand); font-style: normal; }
  .hero-copy .hero-intro { max-width: 590px; margin: 26px 0; color: var(--color-muted); font-size: 1.08rem; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .photo-note { position: absolute; z-index: 2; right: 0; bottom: 20px; left: 0; color: rgba(51,61,71,.52); font-size: .72rem; text-align: right; }
  .metrics { background: var(--color-ink); color: white; }
  .metric-grid { display: grid; grid-template-columns: repeat(3,1fr); }
  .metric-grid div { display: grid; gap: 4px; padding: 30px 6%; border-right: 1px solid rgba(255,255,255,.12); }
  .metric-grid b { font-size: 2rem; } .metric-grid span { color: rgba(255,255,255,.65); }
  .split { display: grid; grid-template-columns: 1fr 1fr; gap: 8vw; }
  .audiences { background: var(--color-canvas); }
  .audience-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 18px; margin-top: 48px; }
  .audience-grid article { padding: 30px; border-top: 3px solid var(--color-olive); background: white; }
  .audience-grid span { color: var(--color-olive); font-size: .78rem; font-weight: 800; }
  .audience-grid h3 { margin: 24px 0 8px; font-size: 1.4rem; }
  .audience-grid p { margin: 0; color: var(--color-muted); }
  .story { color: var(--color-muted); font-size: 1.08rem; } .story p:first-child { margin-top: 0; }
  .specialties { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 26px; }
  .specialties span { padding: 8px 13px; border: 1px solid var(--color-line); border-radius: 999px; background: white; color: var(--color-ink); font-size: .84rem; }
  .team { background: white; }
  .team-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 18px; margin-top: 48px; }
  .team-link { display: inline-block; margin-top: 28px; color: var(--color-brand); font-weight: 750; text-decoration: none; }
  .strengths { background: var(--color-charcoal); color: white; }
  .strength-grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: 8vw; }
  .strength-list article { display: grid; grid-template-columns: 48px 1fr; gap: 20px; padding: 24px 0; border-bottom: 1px solid rgba(255,255,255,.14); }
  .strength-list b { color: var(--color-olive); }
  .strength-list h3 { margin: 0 0 5px; font-size: 1.25rem; }
  .strength-list p { margin: 0; color: rgba(255,255,255,.62); }
  .featured-product { background: white; }
  .product-card { display: grid; grid-template-columns: 1.25fr .75fr; gap: 50px; align-items: center; padding: clamp(38px,7vw,86px); border-radius: var(--radius-lg); background: var(--color-canvas); }
  .product-card h2 { max-width: 700px; margin: 0; font-size: clamp(2rem,4vw,3.6rem); line-height: 1.15; }
  .product-card p:not(.eyebrow) { max-width: 680px; color: var(--color-muted); }
  .product-mark { min-height: 280px; display: flex; flex-direction: column; justify-content: end; padding: 30px; border-radius: var(--radius-md); background: var(--color-olive); color: white; }
  .product-mark span,.product-mark small { opacity: .72; }
  .product-mark strong { font-size: 3rem; line-height: 1.1; }
  .promise { background: white; padding-top: 0; }
  .promise-card { padding: clamp(40px,7vw,90px); border-radius: var(--radius-lg); background: var(--color-canvas); text-align: center; }
  blockquote { margin: 10px auto 18px; font-size: clamp(2rem,5vw,4.4rem); font-weight: 850; line-height: 1.18; letter-spacing: -.045em; }
  .promise-card>p:last-child { color: var(--color-muted); }
  @media (max-width: 840px) { .hero { min-height: auto; padding-top: 365px; background-position: top left; background-size: auto 365px; } .hero::after { background: linear-gradient(180deg, transparent 235px, #fff 365px); } .hero-grid,.split,.strength-grid,.product-card { grid-template-columns: 1fr; min-height: auto; } .hero-copy { grid-column: 1; max-width: none; padding: 44px 0 72px; } .photo-note { top: 330px; bottom: auto; color: rgba(51,61,71,.6); text-align: left; } .team-grid { grid-template-columns: repeat(2,1fr); } .audience-grid { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { h1 { font-size: 3.25rem; } .hero-belief { font-size: 1.45rem; } .metric-grid { grid-template-columns: 1fr; } .metric-grid div { border-right: 0; border-bottom: 1px solid rgba(255,255,255,.12); } .team-grid { grid-template-columns: 1fr 1fr; gap: 10px; } .member div { padding: 14px; } }
</style>
