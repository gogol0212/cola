---
import BaseLayout from '../layouts/BaseLayout.astro';

const heroTags = ['儿童医疗保障', '成人医疗与重疾', '养老与家庭财富规划'];
const scenarios = [
  { num: '01', title: '孩子住院，医保外费用怎么办？', desc: '住院、门诊与目录外用药，孩子生病时的费用结构怎么安排。', href: '/products/youtongxing/', mark: '儿童保障' },
  { num: '02', title: '成人医疗险为什么价格差这么多？', desc: '免赔口径、医院范围、用药与责任宽度，价格差异到底差在哪。', href: '/knowledge/medical-insurance-comparison/', mark: '保险知识' },
  { num: '03', title: '大病治疗，院外药、CAR-T、质子重离子怎么衔接？', desc: '大病面前的用药能力与治疗方式，保障工具之间如何衔接。', href: '/products/zhixuan-yisheng/', mark: '成人保障' },
  { num: '04', title: '家庭责任期，收入中断和身故风险怎么安排？', desc: '收入、房贷、孩子教育与家庭责任，靠什么安排兜底。', href: '/products/', mark: '家庭责任' },
  { num: '05', title: '养老现金流，靠什么长期稳定？', desc: '长寿阶段的现金流与照护安排，靠什么长期持续。', href: '/products/', mark: '养老规划' },
  { num: '06', title: '有海外资产或跨境生活安排，保障如何统一？', desc: '跨境生活的健康与保障安排，如何放在同一套框架里。', href: '/contact/', mark: '跨境规划' },
];
const process = [
  { num: '01', title: '看清现状', desc: '整理医保、已有保单、家庭成员、预算和责任阶段。' },
  { num: '02', title: '找出缺口', desc: '区分小额风险、大额医疗风险、收入中断风险和长期现金流风险。' },
  { num: '03', title: '比较方案', desc: '不只看保费和保额，而是看医院范围、免赔口径、责任边界、用药能力和服务方式。' },
  { num: '04', title: '长期复盘', desc: '随孩子成长、收入变化、父母年龄变化和资产结构变化，定期检查保障是否还合适。' },
];
const featured = [
  { eyebrow: '儿童保障', title: '友童行：儿童意外门诊、疾病住院与医保目录外费用说明。', href: '/products/youtongxing/', mark: '友童行', tag: '儿童' },
  { eyebrow: '成人保障', title: '智选逸生：一般医疗、重疾医疗、质子重离子、CAR-T 与院外药械。', href: '/products/zhixuan-yisheng/', mark: '智选逸生', tag: '成人' },
  { eyebrow: '保险知识', title: '不同价格的医疗险，差异到底在哪：从免赔、医院、用药、责任与服务五维看懂差距。', href: '/knowledge/medical-insurance-comparison/', mark: '深度对比', tag: '知识' },
];
const teamStats = [
  { value: '20', suffix: '+', label: '跨行业伙伴' },
  { value: '100', suffix: '%', label: '本科及以上学历' },
  { value: '80', suffix: '%', label: '海归 / 985 / 211 / 硕士背景' },
];
---
<BaseLayout title="未来可乐团队｜先看清家庭，再谈保障" description="我们不急着推荐产品，而是先梳理家庭成员、医保基础、责任阶段、预算边界和长期规划，再一起选择合适的保障方案。">
  <section class="home-hero no-select">
    <div class="home-hero__media">
      <img src="/assets/images/AIA%20Tower.webp" alt="友邦大楼" class="home-hero__image" width="1218" height="1280" loading="eager" fetchpriority="high" />
    </div>

    <div class="home-hero__content">
      <div class="home-hero__inner">
        <p class="home-hero__eyebrow">AIA HUBEI · COLA TEAM</p>

        <h1 class="home-hero__title">
          <span>先看清家庭</span>
          <span class="home-hero__title-accent">再谈保障</span>
        </h1>

        <div class="home-hero__rule"></div>

        <p class="home-hero__description">
          我们不急着推荐产品，而是先梳理家庭成员、医保基础、责任阶段、预算边界和长期规划，再一起选择合适的保障方案。
        </p>

        <div class="home-hero__tags">
          <span>儿童医疗保障</span>
          <span>成人医疗与重疾</span>
          <span>养老与家庭财富规划</span>
        </div>

        <div class="home-hero__actions">
          <a class="home-hero__button home-hero__button--primary" href="#family-scenarios">
            按家庭场景了解保障 →
          </a>
          <a class="home-hero__button home-hero__button--secondary" href="/team/">
            认识未来可乐团队
          </a>
        </div>
      </div>
    </div>
  </section>

  <section id="family-scenarios" class="family-scenarios"><div class="section-container">
    <p class="section-eyebrow">Family Scenarios</p>
    <h2 class="section-title">从你正在面对的处境进入</h2>
    <p class="section-description">每个家庭的风险并不抽象，它往往发生在具体情境里。选择一个你当前最关心的方向，我们从这里开始。</p>
    <div class="scenario-grid">
      {scenarios.map(scene => <a class="scenario-card reveal" href={scene.href}>
        <div class="sc-top"><span class="sc-num">{scene.num}</span><span class="sc-arr">→</span></div>
        <h3>{scene.title}</h3>
        <p>{scene.desc}</p>
        <span class="sc-mark">{scene.mark}</span>
      </a>)}
    </div>
  </div></section>

  <section class="section process"><div class="container">
    <header class="block-head center">
      <p class="eyebrow">How We Plan</p>
      <h2 class="section-title">我们如何做规划</h2>
      <p class="section-lead">不是一锤子买卖，而是先梳理、再设计、持续跟进的四步方法。</p>
    </header>
    <div class="process-grid">
      {process.map((step, i) => <article class="process-step reveal">
        <div class="ps-circle"><span>{step.num}</span></div>
        <h3>{step.title}</h3>
        <p>{step.desc}</p>
        {i < process.length - 1 && <span class="ps-line" aria-hidden="true"></span>}
      </article>)}
    </div>
  </div></section>

  <section class="section featured"><div class="container">
    <header class="block-head">
      <p class="eyebrow">Selected Content</p>
      <h2 class="section-title">先弄懂这些<br />再决定怎么选</h2>
      <p class="section-lead">三份深度内容，把保障中最容易被忽略的部分讲清楚。</p>
    </header>
    <div class="featured-grid">
      {featured.map(item => <a class="featured-card reveal" href={item.href}>
        <span class="fd-mark">{item.mark}</span>
        <span class="fd-tag">{item.tag}</span>
        <p class="fd-eyebrow">{item.eyebrow}</p>
        <h3>{item.title}</h3>
        <span class="fd-arr">阅读全文 <b>→</b></span>
      </a>)}
    </div>
  </div></section>

  <section class="section why"><div class="container">
    <div class="why-inner">
      <p class="eyebrow on-dark">Why Cola</p>
      <h2 class="section-title">一群跨行业背景的人<br />长期做一件专业的事</h2>
      <p class="why-text">未来可乐团队成员来自金融、教育、医疗、互联网、品牌、企业经营等领域。我们不追求短期热闹，而是希望把保险服务做得更专业、更久、更稳。</p>
      <div class="why-stats">
        {teamStats.map(stat => <div class="why-stat"><b><span data-count={stat.value}>{stat.value}</span>{stat.suffix}</b><span class="ws-label">{stat.label}</span></div>)}
      </div>
      <div class="why-action"><a class="button" href="/team/">查看完整团队介绍<span class="btn-arrow">→</span></a></div>
    </div>
  </div></section>

  <section class="section cta"><div class="container cta-grid">
    <div class="cta-card client reveal">
      <span class="cta-icon">☰</span>
      <p class="eyebrow on-dark">For Clients</p>
      <h3>我是客户，想梳理家庭保障</h3>
      <p>孩子医疗、成人医疗、重疾、养老、财富规划，都可以先从一次保障梳理开始。</p>
      <div class="cta-actions">
        <a class="button" href="/contact/">微信咨询<span class="btn-arrow">→</span></a>
        <a class="button secondary on-dark" href="/contact/">预约保障梳理</a>
      </div>
    </div>
    <div class="cta-card join reveal">
      <span class="cta-icon">＋</span>
      <p class="eyebrow">For Talent</p>
      <h3>我想了解未来可乐团队</h3>
      <p>如果你正在考虑职业转型，想找一条更长期、更专业的路径，可以了解我们的团队和人才计划。</p>
      <div class="cta-actions">
        <a class="button" href="/join/">了解加入可乐<span class="btn-arrow">→</span></a>
      </div>
    </div>
  </div></section>
</BaseLayout>
<script>
  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
  }, { threshold: 0.15 });
  document.querySelectorAll('.reveal').forEach(el => io.observe(el));

  const counters = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (!e.isIntersecting) return;
      const el = e.target as HTMLElement;
      const raw = el.dataset.count || '';
      const target = parseFloat(raw);
      const dur = 1500;
      const start = performance.now();
      const tick = (now: number) => {
        const p = Math.min((now - start) / dur, 1);
        const eased = 1 - Math.pow(1 - p, 3);
        el.textContent = String(Math.round(target * eased));
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
      counters.unobserve(el);
    });
  }, { threshold: 0.5 });
  document.querySelectorAll('[data-count]').forEach(el => counters.observe(el));
</script>
<style>
  .home-hero {
    width: 100%;
    min-height: 740px;
    display: grid;
    grid-template-columns: minmax(0, 50%) minmax(0, 50%);
    background: #f7f3ee;
    overflow: hidden;
  }

  .home-hero__media {
    position: relative;
    min-height: 740px;
    max-height: 960px;
    background: #e9e1d8;
    overflow: hidden;
  }

  .home-hero__media::after {
    content: "";
    position: absolute;
    top: 0;
    right: -1px;
    width: 160px;
    height: 100%;
    background: linear-gradient(
      90deg,
      rgba(247, 243, 238, 0) 0%,
      rgba(247, 243, 238, 0.82) 72%,
      #f7f3ee 100%
    );
    pointer-events: none;
  }

  .home-hero__image {
    width: 100%;
    height: 100%;
    min-height: 740px;
    max-height: 960px;
    object-fit: cover;
    object-position: center 16%;
    display: block;
    filter: contrast(1.04) saturate(0.96) brightness(1.04);
  }

  .home-hero__content {
    min-height: 640px;
    display: flex;
    align-items: center;
    background:
      radial-gradient(circle at 82% 18%, rgba(211, 17, 69, 0.06), transparent 28%),
      linear-gradient(135deg, #f8f5ef 0%, #f3ede5 100%);
  }

  .home-hero__inner {
    width: min(100%, 560px);
    margin-left: clamp(28px, 4vw, 72px);
    margin-right: clamp(16px, 2.5vw, 48px);
  }

  .home-hero__eyebrow {
    margin: 0 0 22px;
    font-size: 12px;
    line-height: 1;
    letter-spacing: 0.18em;
    font-weight: 800;
    color: #d31145;
    text-transform: uppercase;
  }

  .home-hero__title {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: clamp(48px, 4.8vw, 76px);
    line-height: 1.05;
    letter-spacing: -0.06em;
    font-weight: 900;
    color: #303943;
  }

  .home-hero__title-accent {
    color: #d31145;
  }

  .home-hero__rule {
    width: 54px;
    height: 4px;
    margin: 26px 0 26px;
    background: #d31145;
    border-radius: 999px;
  }

  .home-hero__description {
    max-width: 520px;
    margin: 0;
    font-size: 17px;
    line-height: 1.95;
    color: #4d5763;
    font-weight: 500;
  }

  .home-hero__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }

  .home-hero__tags span {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    padding: 0 16px;
    border-radius: 999px;
    border: 1px solid rgba(48, 57, 67, 0.16);
    background: rgba(255, 255, 255, 0.72);
    color: #303943;
    font-size: 13px;
    font-weight: 700;
    white-space: nowrap;
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 30px;
  }

  .home-hero__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 0 22px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 800;
    text-decoration: none;
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }

  .home-hero__button:hover {
    transform: translateY(-1px);
  }

  .home-hero__button--primary {
    background: #d31145;
    color: #fff;
    box-shadow: 0 14px 28px rgba(211, 17, 69, 0.18);
  }

  .home-hero__button--secondary {
    background: rgba(255, 255, 255, 0.72);
    color: #303943;
    border: 1px solid rgba(48, 57, 67, 0.18);
  }

  .family-scenarios { padding-top: clamp(72px, 7vw, 96px); }
  .section-container { width: min(calc(100% - 40px), var(--content)); margin-inline: auto; }
  .section-eyebrow { margin: 0 0 12px; color: var(--color-brand); font-size: .78rem; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; }
  .family-scenarios .section-title { margin: 0; font-size: clamp(2rem, 2.8vw, 2.7rem); line-height: 1.25; letter-spacing: -.035em; color: var(--color-charcoal); }
  .section-description { max-width: 720px; margin: 20px 0 0; color: var(--color-muted); font-size: clamp(1rem, 2vw, 1.2rem); }
  .block-head { max-width: 680px; }
  .block-head.center { margin-inline: auto; text-align: center; }
  .block-head.center .section-lead { margin-inline: auto; }
  .block-head .section-lead { color: var(--color-muted); margin-top: 12px; }
  .scenario-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-top: clamp(22px, 3vw, 32px); }
  .scenario-card { position: relative; display: flex; flex-direction: column; padding: 26px 24px 24px; border: 1px solid #E8E2DA; border-radius: 20px; background: #fffdfb; text-decoration: none; transition: transform .35s, box-shadow .35s, border-color .35s; }
  .scenario-card:hover { transform: translateY(-4px); border-color: rgba(211,17,69,.45); box-shadow: var(--shadow-card); }
  .sc-top { display: flex; align-items: center; justify-content: space-between; }
  .sc-num { color: var(--color-olive); font-size: .84rem; font-weight: 800; letter-spacing: .12em; }
  .sc-arr { color: var(--color-brand); font-size: 1.15rem; transition: transform .3s; }
  .scenario-card:hover .sc-arr { transform: translate(3px, -3px); }
  .scenario-card h3 { margin: 16px 0 10px; font-size: 1.16rem; line-height: 1.45; letter-spacing: -.01em; }
  .scenario-card p { flex: 1; margin: 0 0 20px; color: var(--color-muted); font-size: .9rem; line-height: 1.75; }
  .sc-mark { align-self: flex-start; padding: 6px 13px; border-radius: 999px; background: rgba(165,145,92,.14); color: var(--color-olive); font-size: .78rem; font-weight: 800; }

  .process { background: white; }
  .process-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; margin-top: 54px; }
  .process-step { position: relative; padding: 34px 24px; border-radius: var(--radius-md); background: var(--color-canvas); transition: transform .35s, box-shadow .35s; }
  .process-step:hover { transform: translateY(-5px); box-shadow: var(--shadow-card); }
  .ps-circle { display: grid; place-items: center; width: 58px; height: 58px; border-radius: 50%; background: var(--color-brand); color: white; font-size: 1.05rem; font-weight: 800; box-shadow: 0 10px 24px rgba(211,17,69,.28); }
  .process-step:nth-child(2) .ps-circle { background: var(--color-olive); box-shadow: 0 10px 24px rgba(165,145,92,.3); }
  .process-step h3 { margin: 22px 0 8px; font-size: 1.25rem; }
  .process-step p { margin: 0; color: var(--color-muted); font-size: .92rem; line-height: 1.75; }
  .ps-line { position: absolute; top: 50%; right: -18px; width: 18px; height: 2px; background: linear-gradient(90deg, rgba(165,145,92,.7), rgba(165,145,92,.15)); }
  @media (max-width: 900px) { .ps-line { display: none; } }

  .featured { background: var(--color-canvas); }
  .featured-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-top: 48px; }
  .featured-card { position: relative; display: flex; flex-direction: column; padding: 32px 28px 28px; border: 1px solid var(--color-line); border-radius: var(--radius-lg); background: white; text-decoration: none; transition: transform .35s, box-shadow .35s, border-color .35s; overflow: hidden; }
  .featured-card:before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px; background: linear-gradient(90deg, var(--color-brand), var(--color-olive)); opacity: 0; transition: opacity .35s; }
  .featured-card:hover { transform: translateY(-5px); box-shadow: var(--shadow-card); }
  .featured-card:hover:before { opacity: 1; }
  .fd-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 22px; }
  .fd-mark { align-self: flex-start; padding: 8px 16px; border-radius: 999px; background: var(--color-charcoal); color: white; font-size: .84rem; font-weight: 800; }
  .featured-card:nth-child(2) .fd-mark { background: var(--color-brand); }
  .featured-card:nth-child(3) .fd-mark { background: var(--color-olive); }
  .fd-tag { position: absolute; top: 30px; right: 26px; color: var(--color-muted); font-size: .78rem; font-weight: 700; }
  .fd-eyebrow { margin: 0 0 10px; color: var(--color-brand); font-size: .8rem; font-weight: 800; letter-spacing: .12em; }
  .featured-card h3 { flex: 1; margin: 0 0 24px; font-size: 1.22rem; line-height: 1.55; letter-spacing: -.01em; }
  .fd-arr { color: var(--color-brand); font-size: .94rem; font-weight: 750; }
  .fd-arr b { display: inline-block; transition: transform .3s; }
  .featured-card:hover .fd-arr b { transform: translateX(5px); }

  .why { background: var(--color-charcoal); color: white; }
  .why::before { content: ''; display: block; width: 100%; height: 1px; background: linear-gradient(90deg, transparent, rgba(255,255,255,.18), transparent); }
  .why-inner { max-width: 860px; margin-inline: auto; text-align: center; }
  .why-inner .section-title { color: white; }
  .why-text { max-width: 720px; margin: 24px auto 0; color: rgba(255,255,255,.74); font-size: 1.08rem; line-height: 1.9; }
  .why-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 52px; }
  .why-stat { padding: 32px 20px; border: 1px solid rgba(255,255,255,.14); border-radius: var(--radius-md); background: rgba(255,255,255,.05); backdrop-filter: blur(4px); transition: transform .35s, background .35s; }
  .why-stat:hover { transform: translateY(-4px); background: rgba(255,255,255,.09); }
  .why-stat b { display: block; color: var(--color-olive); font-size: clamp(2.4rem, 5vw, 3.8rem); line-height: 1; letter-spacing: -.03em; }
  .ws-label { margin-top: 14px; display: block; color: rgba(255,255,255,.72); font-size: .94rem; }
  .why-action { margin-top: 46px; }

  .cta { background: white; }
  .cta-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .cta-card { position: relative; overflow: hidden; padding: clamp(38px, 5vw, 58px); border-radius: var(--radius-lg); }
  .cta-card h3 { margin: 0 0 14px; font-size: clamp(1.7rem, 3.2vw, 2.4rem); line-height: 1.25; letter-spacing: -.02em; }
  .cta-card p { margin: 0; line-height: 1.85; }
  .cta-card .eyebrow.on-dark { color: var(--color-olive); }
  .cta-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
  .cta-card.client { background: #333d47; color: white; }
  .cta-card.client p { color: rgba(255,255,255,.72); }
  .cta-card.join { border: 1px solid var(--color-line); background: var(--color-canvas); }
  .cta-card.join p { color: var(--color-muted); }
  .cta-icon { position: absolute; top: 22px; right: 26px; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 12px; background: rgba(255,255,255,.1); color: var(--color-olive); font-size: 1.3rem; font-weight: 800; }
