---
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Tracker from '../components/Tracker.astro';
import '../styles/global.css';

interface Props { title: string; description: string; image?: string; type?: string; noindex?: boolean; }
const { title, description, image, type, noindex } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <Seo title={title} description={description} image={image} type={type} noindex={noindex} />
  </head>
  <body><Header /><main><slot /></main><Footer /><Tracker />
    <script>
      // 基础内容保护：仅针对图片，不影响正文阅读与复制
      document.querySelectorAll('img').forEach((img) => {
        img.setAttribute('draggable', 'false');
        img.addEventListener('contextmenu', (e) => e.preventDefault());
      });
    </script>
  </body>
</html>
