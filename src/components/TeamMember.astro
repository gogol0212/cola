---
interface Props { name: string; school: string; role: string; years: string; image: string; tags?: string[]; }
const { name, school, role, years, image, tags = [] } = Astro.props;
---
<article class="member-card">
  <div class="photo"><img src={`/assets/images/${image}`} loading="lazy" width="600" alt={`${name}，未来可乐团队成员`} /></div>
  <div class="info">
    <h3>{name}</h3>
    <p class="school">{school}</p>
    <p class="role">{role}</p>
    <div class="tags">{tags.map(tag => <span>{tag}</span>)}</div>
    <span class="tenure">{years}</span>
  </div>
</article>
<style>
  .member-card { position: relative; overflow: hidden; border: 1px solid var(--color-line); border-radius: var(--radius-md); background: white; transition: transform .4s cubic-bezier(.2,.7,.3,1), box-shadow .4s, border-color .4s; }
  .member-card:hover { transform: translateY(-8px); box-shadow: 0 24px 60px rgba(25,31,40,.14); border-color: rgba(165,145,92,.55); }
  .photo { position: relative; aspect-ratio: 4/5; overflow: hidden; background: var(--color-canvas); }
  img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 18%; filter: saturate(.92); transition: transform .7s cubic-bezier(.2,.7,.3,1); }
  .member-card:hover img { transform: scale(1.05); }
  .info { padding: 22px 20px 24px; text-align: center; }
  h3 { margin: 0 0 6px; font-size: 1.3rem; letter-spacing: .02em; }
  .school { margin: 0 0 5px; color: var(--color-olive); font-size: .9rem; font-weight: 750; }
  .role { margin: 0 0 14px; color: var(--color-muted); font-size: .84rem; line-height: 1.5; min-height: 2.5em; }
  .tags { display: flex; flex-wrap: nowrap; justify-content: center; align-items: center; gap: 6px; margin-bottom: 16px; min-height: 26px; }
  .tags span { flex: 0 0 auto; padding: 4px 11px; border-radius: 999px; background: rgba(165,145,92,.1); color: var(--color-dark-green); font-size: .72rem; font-weight: 700; white-space: nowrap; }
  .tenure { display: inline-block; padding: 5px 14px; border-radius: 999px; background: var(--color-canvas); color: var(--color-dark-green); font-size: .74rem; font-weight: 750; border: 1px solid rgba(104,101,90,.25); }
</style>
