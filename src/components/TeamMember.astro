---
interface Props { name: string; school: string; role: string; years: string; image: string; featured?: boolean; }
const { name, school, role, years, image, featured = false } = Astro.props;
---
<article class:list={['member-card', { featured }]}>
  <img src={`/assets/images/${image}`} loading="lazy" width="600" height="800" alt={`${name}，未来可乐团队成员`} />
  <div class="content"><div class="name-row"><h3>{name}</h3><span>{years}</span></div><p>{school}</p><small>{role}</small></div>
</article>
<style>
  .member-card { overflow: hidden; border: 1px solid var(--color-line); border-radius: var(--radius-md); background: white; }
  img { width: 100%; aspect-ratio: 4/5; object-fit: cover; object-position: top; background: var(--color-canvas); filter: saturate(.9); }
  .content { padding: 20px; }
  .name-row { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; }
  h3 { margin: 0; font-size: 1.25rem; }
  span { color: var(--color-brand); font-size: .72rem; font-weight: 750; }
  p { margin: 7px 0 2px; font-size: .82rem; }
  small { color: var(--color-muted); }
  .featured { box-shadow: var(--shadow-card); }
</style>
