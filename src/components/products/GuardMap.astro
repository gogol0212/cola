---
// 保障地图 · 客户阅读模式
// 用卡片 + 手风琴呈现每项责任：5 秒看懂「解决什么 + 核心数字」，点击展开合同细节。
import type { Responsibility } from "../../data/product-duty";

type Props = {
  responsibilities: Responsibility[];
  /** 药品/医院分类 id -> 名称，用于展示关联清单标签 */
  drugClassNames?: Record<string, string>;
  hospitalClassNames?: Record<string, string>;
};

const { responsibilities, drugClassNames = {}, hospitalClassNames = {} } = Astro.props as Props;

const groups = [...new Set(responsibilities.map((r) => r.group))];
const className = (id: string) => drugClassNames[id] || hospitalClassNames[id] || "";
---
<section class="guard-map">
  {
    groups.map((group) => (
      <div class="guard-group">
        <h3 class="guard-group__title">{group}</h3>
        <div class="guard-group__cards">
          {
            responsibilities
              .filter((r) => r.group === group)
              .map((r, i) => (
                <article class="guard-card" id={r.key} data-guard-card>
                  <header class="guard-card__head">
                    <div class="guard-card__titles">
                      <h4>{r.title}</h4>
                      <p class="guard-card__contract">{r.contract}</p>
                    </div>
                    {r.required && <span class="guard-card__badge">必选</span>}
                  </header>

                  <p class="guard-card__problem">
                    <b>解决：</b>{r.problem}
                  </p>

                  <div class="guard-card__chips">
                    {r.chips.map((c) => (
                      <div class:list={["guard-chip", c.tone === "brand" && "is-brand", c.tone === "olive" && "is-olive"]}>
                        <span class="guard-chip__label">{c.label}</span>
                        <strong class="guard-chip__value">{c.value}</strong>
                      </div>
                    ))}
                  </div>

                  <details class="guard-card__detail">
                    <summary>
                      查看详细责任<span class="guard-chev" aria-hidden="true" />
                    </summary>
                    <div class="guard-card__body">
                      <ul class="guard-card__list">
                        {r.details.map((d) => (
                          <li>{d}</li>
                        ))}
                      </ul>
                      {
                        r.related && r.related.length > 0 && (
                          <div class="guard-card__tags">
                            {r.related.map((id) => className(id) ? <span>{className(id)}</span> : null)}
                          </div>
                        )
                      }
                    </div>
                  </details>
                </article>
              ))
          }
        </div>
      </div>
    ))
  }
</section>

<style>
  .guard-map {
    display: grid;
    gap: 40px;
    margin-top: 12px;
  }
  .guard-group__title {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 16px;
    padding: 8px 16px;
    border-radius: 999px;
    background: rgba(165, 145, 92, 0.14);
    color: var(--color-dark-green);
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.04em;
  }
  .guard-group__cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .guard-card {
    display: flex;
    flex-direction: column;
    padding: 24px;
    border: 1px solid var(--color-line);
    border-radius: 22px;
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
  }
  .guard-card__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }
  .guard-card__titles {
    min-width: 0;
  }
  .guard-card h4 {
    margin: 0;
    font-size: 1.28rem;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }
  .guard-card__contract {
    margin: 6px 0 0;
    color: var(--color-muted);
    font-size: 0.78rem;
    line-height: 1.5;
  }
  .guard-card__badge {
    flex: 0 0 auto;
    padding: 4px 11px;
    border-radius: 999px;
    background: var(--color-brand);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 800;
  }
  .guard-card__problem {
    margin: 16px 0 0;
    color: var(--color-ink);
    font-size: 0.94rem;
    line-height: 1.75;
  }
  .guard-card__problem b {
    color: var(--color-olive);
  }
  .guard-card__chips {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    margin: 18px 0 0;
  }
  .guard-chip {
    display: grid;
    gap: 2px;
    padding: 12px 8px;
    border-radius: 14px;
    background: rgba(211, 202, 195, 0.24);
    text-align: center;
  }
  .guard-chip.is-brand {
    background: rgba(211, 17, 69, 0.07);
  }
  .guard-chip.is-olive {
    background: rgba(165, 145, 92, 0.12);
  }
  .guard-chip__label {
    color: var(--color-muted);
    font-size: 0.7rem;
    font-weight: 650;
  }
  .guard-chip__value {
    color: var(--color-ink);
    font-size: 1.28rem;
    font-weight: 850;
    line-height: 1.2;
  }
  .guard-chip.is-brand .guard-chip__value {
    color: var(--color-brand);
  }
  .guard-card__detail {
    margin-top: 18px;
    border-top: 1px dashed var(--color-line);
  }
  .guard-card__detail summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 2px 0;
    cursor: pointer;
    color: var(--color-brand);
    font-size: 0.9rem;
    font-weight: 800;
    list-style: none;
  }
  .guard-card__detail summary::-webkit-details-marker {
    display: none;
  }
  .guard-chev {
    width: 9px;
    height: 9px;
    border-right: 2px solid var(--color-brand);
    border-bottom: 2px solid var(--color-brand);
    transform: rotate(45deg);
    transition: transform 0.18s;
  }
  .guard-card__detail[open] .guard-chev {
    transform: rotate(-135deg);
  }
  .guard-card__body {
    padding-top: 6px;
  }
  .guard-card__list {
    display: grid;
    gap: 9px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }
  .guard-card__list li {
    position: relative;
    padding-left: 26px;
    color: var(--color-ink);
    font-size: 0.88rem;
    line-height: 1.7;
  }
  .guard-card__list li::before {
    content: "✓";
    position: absolute;
    left: 0;
    top: 0;
    color: var(--color-olive);
    font-weight: 850;
  }
  .guard-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }
  .guard-card__tags span {
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(211, 17, 69, 0.06);
    color: var(--color-brand);
    font-size: 0.74rem;
    font-weight: 750;
  }

  @media (max-width: 900px) {
    .guard-group__cards {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .guard-map {
      gap: 30px;
    }
    .guard-card {
      padding: 20px;
      border-radius: 20px;
    }
    .guard-card h4 {
      font-size: 1.16rem;
    }
    .guard-chip__value {
      font-size: 1.14rem;
    }
  }
</style>
