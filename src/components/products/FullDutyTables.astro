---
// 完整责任数据库 · 专业模式
// 桌面端呈现完整表格；手机端不横向滚动，改为责任卡片堆叠。
import type { FullSection, RowCell } from "../../data/product-duty";

type Props = { sections: FullSection[] };
const { sections = [] } = Astro.props as Props;

const cellText = (c: RowCell) => (typeof c === "string" ? c : c.text);
const cellTone = (c: RowCell) => (typeof c === "string" ? "" : c.tone ?? "");
---
<div class="full-duty">
  {
    sections.map((sec) => (
      <section class="full-duty__section" id={sec.id}>
        <h3 class="full-duty__section-title">{sec.title}</h3>
        {sec.intro && <p class="full-duty__intro">{sec.intro}</p>}

        <div class="full-duty__groups">
          {
            sec.groups.map((g) => (
              <article class="full-duty__group">
                <h4>{g.title}</h4>
                {g.chips && (
                  <div class="full-duty__chips">
                    {g.chips.map((c) => (
                      <span class:list={["fd-chip", c.tone === "brand" && "is-brand"]}>
                        {c.label} <b>{c.value}</b>
                      </span>
                    ))}
                  </div>
                )}

                <div class="full-duty__table-wrap">
                  <table class="full-duty__table">
                    <thead>
                      <tr>{g.headers.map((h) => <th>{h}</th>)}</tr>
                    </thead>
                    <tbody>
                      {g.rows.map((row) => (
                        <tr>
                          {row.map((cell, colIndex) => <td class:list={[`tone-${cellTone(cell)}`]} data-head={g.headers[colIndex]}>{cellText(cell)}</td>)}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>

                {g.note && <p class="full-duty__note">{g.note}</p>}
              </article>
            ))
          }
        </div>

        {sec.footnotes && (
          <ol class="full-duty__footnotes">
            {sec.footnotes.map((f) => <li>{f}</li>)}
          </ol>
        )}
      </section>
    ))
  }
</div>

<style>
  .full-duty {
    display: grid;
    gap: 36px;
    margin-top: 10px;
  }
  .full-duty__section-title {
    margin: 0;
    font-size: 1.5rem;
    letter-spacing: -0.02em;
  }
  .full-duty__intro {
    margin: 10px 0 0;
    color: var(--color-muted);
    font-size: 0.9rem;
    line-height: 1.7;
  }
  .full-duty__groups {
    display: grid;
    gap: 20px;
    margin-top: 22px;
  }
  .full-duty__group {
    padding: 24px;
    border: 1px solid var(--color-line);
    border-radius: 20px;
    background: var(--color-surface);
  }
  .full-duty__group h4 {
    margin: 0 0 14px;
    font-size: 1.06rem;
  }
  .full-duty__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin-bottom: 16px;
  }
  .fd-chip {
    padding: 7px 14px;
    border-radius: 999px;
    background: rgba(211, 202, 195, 0.3);
    color: var(--color-muted);
    font-size: 0.82rem;
  }
  .fd-chip b {
    color: var(--color-ink);
    font-weight: 850;
  }
  .fd-chip.is-brand b {
    color: var(--color-brand);
  }
  .full-duty__table-wrap {
    overflow-x: auto;
  }
  .full-duty__table {
    width: 100%;
    min-width: 560px;
    border-collapse: collapse;
    font-size: 0.88rem;
  }
  .full-duty__table th {
    padding: 12px 14px;
    background: var(--color-charcoal);
    color: #fff;
    text-align: left;
    font-weight: 750;
    white-space: nowrap;
  }
  .full-duty__table th:first-child {
    border-top-left-radius: 12px;
  }
  .full-duty__table th:last-child {
    border-top-right-radius: 12px;
  }
  .full-duty__table td {
    padding: 11px 14px;
    border-bottom: 1px solid var(--color-line);
    vertical-align: top;
    line-height: 1.6;
  }
  .full-duty__table tbody tr:last-child td {
    border-bottom: none;
  }
  .full-duty__table tbody tr:nth-child(even) {
    background: rgba(211, 202, 195, 0.1);
  }
  .full-duty__table .tone-olive {
    color: var(--color-olive);
    font-weight: 750;
  }
  .full-duty__table .tone-brand {
    color: var(--color-brand);
    font-weight: 750;
  }
  .full-duty__note {
    margin: 14px 0 0;
    color: var(--color-muted);
    font-size: 0.8rem;
    line-height: 1.7;
  }
  .full-duty__footnotes {
    display: grid;
    gap: 6px;
    margin: 18px 0 0;
    padding-left: 20px;
    color: var(--color-muted);
    font-size: 0.78rem;
    line-height: 1.7;
  }

  /* 手机端：不横向滚动，责任项改为堆叠卡片 */
  @media (max-width: 720px) {
    .full-duty__table-wrap {
      overflow-x: visible;
    }
    .full-duty__table {
      min-width: 0;
      width: 100%;
    }
    .full-duty__table thead {
      display: none;
    }
    .full-duty__table,
    .full-duty__table tbody,
    .full-duty__table tr,
    .full-duty__table td {
      display: block;
      width: 100%;
    }
    .full-duty__table tr {
      margin-bottom: 12px;
      padding: 12px;
      border: 1px solid var(--color-line);
      border-radius: 14px;
      background: var(--color-surface);
    }
    .full-duty__table td {
      padding: 4px 0;
      border: none;
    }
    .full-duty__table td::before {
      content: attr(data-head);
      display: block;
      color: var(--color-olive);
      font-size: 0.7rem;
      font-weight: 800;
    }
    .full-duty__table tbody tr:nth-child(even) {
      background: var(--color-surface);
    }
    .full-duty__group {
      padding: 18px;
      border-radius: 18px;
    }
  }
</style>
