---
const { cases = [] } = Astro.props;
---
{cases.length > 0 ? <div class="claim-list">{cases.map((item: { title:string; background:string; customer:string; result:string; documentImage?:string }) => <article>
  <div class="claim-copy"><span>真实理赔案例</span><h3>{item.title}</h3><dl><div><dt>理赔背景</dt><dd>{item.background}</dd></div><div><dt>客户情况</dt><dd>{item.customer}</dd></div><div><dt>理赔结果</dt><dd>{item.result}</dd></div></dl></div>
  {item.documentImage ? <figure><img src={item.documentImage} alt="已隐去个人敏感信息的理赔通知书" loading="lazy" draggable="false" /><figcaption>理赔通知书已隐去姓名、证件号、保单号等个人信息</figcaption></figure> : <div class="document-placeholder">理赔通知书<br /><small>隐私处理后展示</small></div>}
</article>)}</div> : <div class="claim-empty"><span>Real claim archive</span><h3>真实理赔档案正在整理</h3><p>这里已经预留“理赔背景、客户情况、处理过程、理赔结果和通知书”结构。正式发布前将取得客户授权，并隐去姓名、证件号、保单号、联系方式及医疗隐私。</p></div>}
<style>
  .claim-list article{display:grid;grid-template-columns:1fr .72fr;gap:30px;padding:30px;border:1px solid var(--color-line);border-radius:var(--radius-md);background:white}.claim-copy>span,.claim-empty>span{color:var(--color-brand);font-size:.78rem;font-weight:800;text-transform:uppercase}.claim-copy h3,.claim-empty h3{font-size:1.6rem}.claim-copy dl{margin:26px 0 0}.claim-copy dl>div{display:grid;grid-template-columns:88px 1fr;padding:14px 0;border-top:1px solid var(--color-line)}dt{font-weight:800}dd{margin:0;color:var(--color-muted)}figure{margin:0}figure img,.document-placeholder{width:100%;aspect-ratio:4/3;border-radius:16px;object-fit:contain;background:var(--color-canvas)}figcaption{margin-top:8px;color:var(--color-muted);font-size:.72rem}.document-placeholder{display:grid;place-content:center;text-align:center;color:var(--color-muted);border:1px dashed var(--color-olive)}.document-placeholder small{margin-top:5px}.claim-empty{padding:36px;border:1px dashed var(--color-olive);border-radius:var(--radius-md);background:rgba(165,145,92,.08)}.claim-empty p{max-width:760px;color:var(--color-muted)}@media(max-width:760px){.claim-list article{grid-template-columns:1fr}.claim-copy dl>div{grid-template-columns:1fr;gap:5px}}
</style>
