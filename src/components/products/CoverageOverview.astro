---
type Chip = { label: string; value: string; tone?: "brand" | "olive" };
type Group = {
  title: string;
  chips: Chip[];
  headers: string[];
  rows: (
    string | { text: string; tone?: "brand" | "olive"; muted?: boolean }
  )[][];
  note?: string;
};
type Tab = {
  id: string;
  tab: string;
  heading: string;
  intro?: string;
  groups: Group[];
  footnotes?: string[];
};
type Props = {
  meta?: Chip[];
  tabs?: Tab[];
};
const { meta = [], tabs = [] } = Astro.props as Props;
---

<div class="coverage-overview" data-coverage-overview>
  {
    meta.length > 0 && (
      <ul class="meta-strip">
        {meta.map((m) => (
          <li>
            <b>{m.label}</b>
            <strong>{m.value}</strong>
          </li>
        ))}
      </ul>
    )
  }

  <div class="tab-bar" role="tablist" aria-label="责任分类">
    {
      tabs.map((t, i) => (
        <button
          type="button"
          role="tab"
          class:list={["tab-btn", i === 0 && "is-active"]}
          data-tab-btn={t.id}
          aria-selected={i === 0}
        >
          {t.tab}
        </button>
      ))
    }
  </div>

  {
    tabs.map((t, i) => (
      <section
        class:list={["tab-panel", i === 0 && "is-active"]}
        data-tab-panel={t.id}
        role="tabpanel"
        aria-hidden={i !== 0}
      >
        <header class="panel-head">
          <h3>{t.heading}</h3>
          {t.intro && <p>{t.intro}</p>}
        </header>

        <div class="group-list">
          {t.groups.map((g) => (
            <article class="group-card">
              <div class="group-head">
                <h4>{g.title}</h4>
                <div class="chip-row">
                  {g.chips.map((c) => (
                    <span
                      class:list={[
                        "chip",
                        c.tone === "brand" && "is-brand",
                        c.tone === "olive" && "is-olive",
                      ]}
                    >
                      <b>{c.label}</b>
                      <strong>{c.value}</strong>
                    </span>
                  ))}
                </div>
              </div>
              <div class="table-wrap">
                <table>
                  <thead>
                    <tr>
                      {g.headers.map((h) => (
                        <th>{h}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {g.rows.map((row) => (
                      <tr>
                        {row.map((cell) => (
                          <td
                            class:list={[
                              typeof cell === "object" &&
                                cell.tone === "brand" &&
                                "is-brand",
                              typeof cell === "object" &&
                                cell.tone === "olive" &&
                                "is-olive",
                              typeof cell === "object" &&
                                cell.muted &&
                                "is-muted",
                            ]}
                          >
                            {typeof cell === "object" ? cell.text : cell}
                          </td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              {g.note && <p class="group-note">{g.note}</p>}
            </article>
          ))}
        </div>

        {t.footnotes && (
          <ol class="footnotes">
            {t.footnotes.map((f) => (
              <li>{f}</li>
            ))}
          </ol>
        )}
      </section>
    ))
  }
</div>

<script>
  document
    .querySelectorAll<HTMLElement>("[data-coverage-overview]")
    .forEach((root) => {
      const buttons = Array.from(
        root.querySelectorAll<HTMLButtonElement>("[data-tab-btn]"),
      );
      const panels = Array.from(
        root.querySelectorAll<HTMLElement>("[data-tab-panel]"),
      );
      if (buttons.length === 0 || panels.length === 0) return;
      const setActive = (id: string) => {
        buttons.forEach((btn) => {
          const on = btn.dataset.tabBtn === id;
          btn.classList.toggle("is-active", on);
          btn.setAttribute("aria-selected", String(on));
        });
        panels.forEach((panel) => {
          const on = panel.dataset.tabPanel === id;
          panel.classList.toggle("is-active", on);
          panel.setAttribute("aria-hidden", String(!on));
        });
      };
      buttons.forEach((btn) =>
        btn.addEventListener("click", () =>
          setActive(btn.dataset.tabBtn ?? ""),
        ),
      );
    });
</script>

<style>
  .coverage-overview {
    margin-top: 34px;
  }

  /* 投保信息速览条 */
  .meta-strip {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 12px;
    margin: 0 0 26px;
    padding: 0;
    list-style: none;
  }
  .meta-strip li {
    display: grid;
    gap: 4px;
    padding: 16px 14px;
    border: 1px solid var(--color-line);
    border-radius: 16px;
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
  }
  .meta-strip b {
    color: var(--color-muted);
    font-size: 0.76rem;
    font-weight: 650;
  }
  .meta-strip strong {
    color: var(--color-charcoal);
    font-size: 1.02rem;
    font-weight: 800;
  }

  /* 标签栏 */
  .tab-bar {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding: 6px;
    border-radius: 999px;
    background: rgba(51, 61, 71, 0.06);
  }
  .tab-btn {
    flex: 0 0 auto;
    padding: 10px 18px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--color-muted);
    font: inherit;
    font-size: 0.88rem;
    font-weight: 750;
    cursor: pointer;
    transition: all 0.15s;
  }
  .tab-btn.is-active {
    background: var(--color-charcoal);
    color: #fff;
  }

  /* 面板 */
  .tab-panel {
    display: none;
    padding-top: 28px;
  }
  .tab-panel.is-active {
    display: block;
  }
  .panel-head {
    margin-bottom: 20px;
  }
  .panel-head h3 {
    margin: 0;
    font-size: 1.5rem;
  }
  .panel-head p {
    max-width: 760px;
    margin: 8px 0 0;
    color: var(--color-muted);
    font-size: 0.92rem;
  }

  /* 责任组卡片 */
  .group-list {
    display: grid;
    gap: 16px;
  }
  .group-card {
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: 22px;
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
  }
  .group-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    flex-wrap: wrap;
    padding: 18px 22px;
    background: rgba(211, 202, 195, 0.2);
  }
  .group-head h4 {
    margin: 0;
    font-size: 1.05rem;
  }
  .chip-row {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .chip {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    padding: 7px 14px;
    border: 1px solid rgba(165, 145, 92, 0.35);
    border-radius: 999px;
    background: rgba(165, 145, 92, 0.1);
    white-space: nowrap;
  }
  .chip b {
    color: var(--color-muted);
    font-size: 0.74rem;
    font-weight: 650;
  }
  .chip strong {
    color: var(--color-dark-green);
    font-size: 0.92rem;
    font-weight: 800;
  }
  .chip.is-brand {
    border-color: rgba(211, 17, 69, 0.35);
    background: rgba(211, 17, 69, 0.07);
  }
  .chip.is-brand strong {
    color: var(--color-brand);
  }

  /* 明细表 */
  .table-wrap {
    overflow-x: auto;
  }
  table {
    width: 100%;
    min-width: 640px;
    border-collapse: collapse;
    text-align: left;
    font-size: 0.86rem;
  }
  th {
    padding: 13px 18px;
    background: var(--color-charcoal);
    color: #fff;
    font-weight: 650;
    white-space: nowrap;
  }
  td {
    padding: 12px 18px;
    border-top: 1px solid var(--color-line);
    color: var(--color-ink);
    line-height: 1.6;
  }
  td.is-brand {
    color: var(--color-brand);
    font-weight: 800;
    white-space: nowrap;
  }
  td.is-olive {
    color: var(--color-dark-green);
    font-weight: 750;
    white-space: nowrap;
  }
  td.is-muted {
    color: var(--color-muted);
  }
  tbody tr:nth-child(even) {
    background: rgba(211, 202, 195, 0.12);
  }

  .group-note {
    margin: 0;
    padding: 13px 22px;
    border-top: 1px solid var(--color-line);
    background: rgba(246, 244, 243, 0.6);
    color: var(--color-muted);
    font-size: 0.78rem;
    line-height: 1.7;
  }

  .footnotes {
    margin: 18px 0 0;
    padding-left: 20px;
    color: var(--color-muted);
    font-size: 0.78rem;
    line-height: 1.8;
  }
  .footnotes li {
    margin-bottom: 4px;
  }

  @media (max-width: 900px) {
    .meta-strip {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .meta-strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .tab-btn {
      padding: 9px 14px;
      font-size: 0.82rem;
    }
    .group-head {
      padding: 15px 16px;
    }
    th,
    td {
      padding: 11px 14px;
    }
  }
</style>
