---
const { items = [] } = Astro.props;
---
<div class="faq-list">{items.map((item:{question:string;answer:string}) => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</div>
<style>.faq-list{border-top:1px solid var(--color-line)}details{border-bottom:1px solid var(--color-line)}summary{cursor:pointer;padding:24px 4px;font-size:1.08rem;font-weight:750;list-style:none}summary::after{content:'+';float:right;color:var(--color-brand);font-size:1.4rem}details[open] summary::after{content:'−'}p{max-width:820px;margin:-8px 0 24px;color:var(--color-muted)}</style>
