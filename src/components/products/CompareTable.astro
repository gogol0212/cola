---
type Row = { label: string; product: string; market: string };
const { rows = [], productLabel = "本产品相关责任", marketLabel = "常见基础方案" } = Astro.props;
---
<div class="compare-wrap">
  <table>
    <thead><tr><th>比较维度</th><th class="featured">{productLabel}</th><th>{marketLabel}</th></tr></thead>
    <tbody>{rows.map((row: Row) => <tr><th>{row.label}</th><td class="featured">{row.product}</td><td>{row.market}</td></tr>)}</tbody>
  </table>
</div>
<p class="note">“{marketLabel}”仅作常见责任形态的知识比较，不代表全部产品；实际责任、免赔额及赔付比例以具体合同为准。</p>
<style>
  .compare-wrap{overflow-x:auto;border:1px solid var(--color-line);border-radius:var(--radius-md);background:white}
  table{width:100%;min-width:680px;border-collapse:collapse;text-align:left}th,td{padding:20px;border-bottom:1px solid var(--color-line);vertical-align:top}thead th{background:var(--color-charcoal);color:#fff}.featured{background:rgba(211,17,69,.06)}thead .featured{background:var(--color-brand)}tbody th{width:20%}.note{color:var(--color-muted);font-size:.82rem}
</style>