---
const { title, intro, items = [], note } = Astro.props;
---
<article class="knowledge-block"><header><span>Knowledge</span><h3>{title}</h3><p>{intro}</p></header><div class="knowledge-grid">{items.map((item:{label:string;title:string;text:string}) => <section><b>{item.label}</b><h4>{item.title}</h4><p>{item.text}</p></section>)}</div>{note && <footer>{note}</footer>}</article>
<style>
  .knowledge-block{padding:clamp(26px,5vw,52px);border-radius:var(--radius-lg);background:var(--color-charcoal);color:white}.knowledge-block header>span{color:var(--color-olive);font-size:.78rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.knowledge-block h3{margin:10px 0;font-size:clamp(2rem,4vw,3.2rem)}.knowledge-block header p{max-width:760px;color:rgba(255,255,255,.7)}.knowledge-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:34px}.knowledge-grid section{padding:24px;border:1px solid rgba(255,255,255,.14);border-radius:16px;background:rgba(255,255,255,.06)}.knowledge-grid b{color:var(--color-olive)}.knowledge-grid h4{margin:12px 0 8px}.knowledge-grid p{margin:0;color:rgba(255,255,255,.68);font-size:.9rem}.knowledge-block footer{margin-top:22px;color:rgba(255,255,255,.55);font-size:.78rem}@media(max-width:760px){.knowledge-grid{grid-template-columns:1fr}}
</style>
