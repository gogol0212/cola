---
const { items = [] } = Astro.props;
---
<div class="case-grid">{items.map((item: { image?: string; kicker: string; title: string; scenario: string; analysis: string }) => <article>
  {item.image && <img src={item.image} alt="" loading="lazy" />}
  <div><span>{item.kicker}</span><h3>{item.title}</h3><p>{item.scenario}</p><aside><b>如何看这份保障</b>{item.analysis}</aside></div>
</article>)}</div>
<style>
  .case-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px;margin-top:42px}.case-grid article{overflow:hidden;border:1px solid var(--color-line);border-radius:var(--radius-md);background:white}.case-grid img{width:100%;aspect-ratio:16/9;object-fit:cover}.case-grid article>div{padding:26px}.case-grid span{color:var(--color-brand);font-size:.8rem;font-weight:800}.case-grid h3{margin:8px 0;font-size:1.45rem}.case-grid p{color:var(--color-muted)}.case-grid aside{margin-top:20px;padding:18px;border-radius:14px;background:rgba(165,145,92,.12);color:var(--color-dark-green);font-size:.9rem}.case-grid aside b{display:block;margin-bottom:5px;color:var(--color-ink)}@media(max-width:760px){.case-grid{grid-template-columns:1fr}}
</style>
