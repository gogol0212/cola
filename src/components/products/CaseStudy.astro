---
type SettlementLine = { label: string; value: string; accent?: boolean };
type BenefitColumn = { title: string; lines: string[]; total?: string; note?: string };
type CaseItem = {
  image?: string;
  kicker: string;
  title: string;
  scenario: string;
  analysis: string;
  settlement?: {
    heading?: string;
    expenses: SettlementLine[];
    withoutInsurance: BenefitColumn;
    withInsurance: BenefitColumn;
    highlight?: string;
  };
};
const { items = [] } = Astro.props as { items?: CaseItem[] };
---
<div class="case-grid">
  {items.map((item, index) => <article class:list={['case-card', item.settlement && 'is-flippable']} data-case-card>
    <div class="case-inner">
      <section class="case-face case-front" aria-label={`${item.title} 情景`}>
        {item.image && <img src={item.image} alt="" loading="lazy" />}
        <div class="case-copy"><span class="kicker">{item.kicker}</span><h3>{item.title}</h3><p>{item.scenario}</p><aside><b>如何看这份保障</b>{item.analysis}</aside>
          {item.settlement && <button class="flip-button" type="button" aria-expanded="false" aria-controls={`case-result-${index}`}>查看理赔测算 <span aria-hidden="true">→</span></button>}
        </div>
      </section>
      {item.settlement && <section class="case-face case-back" id={`case-result-${index}`} aria-label={`${item.title} 理赔测算`} aria-hidden="true">
        <div class="back-top"><div><span class="kicker">Claim illustration</span><h3>{item.settlement.heading || '理赔测算示例'}</h3></div><button class="close-button" type="button" aria-label="返回案例情景">×</button></div>
        <dl class="expense-list">{item.settlement.expenses.map((line) => <div><dt>{line.label}</dt><dd class:list={[line.accent && 'accent']}>{line.value}</dd></div>)}</dl>
        <div class="benefit-compare">
          {[item.settlement.withoutInsurance, item.settlement.withInsurance].map((column, columnIndex) => <section class:list={[columnIndex === 1 && 'insured']}><h4>{column.title}</h4><ul>{column.lines.map((line) => <li>{line}</li>)}</ul>{column.total && <strong>{column.total}</strong>}{column.note && <small>{column.note}</small>}</section>)}
        </div>
        {item.settlement.highlight && <p class="claim-highlight">{item.settlement.highlight}</p>}
        <p class="calculation-note">以上仅为责任理解与计算示例，实际赔付以保险合同、真实费用及理赔审核为准。</p>
      </section>}
    </div>
  </article>)}
</div>

<script>
  document.querySelectorAll('[data-case-card]').forEach((card) => {
    const open = card.querySelector('.flip-button');
    const close = card.querySelector('.close-button');
    const back = card.querySelector('.case-back');
    if (!(open instanceof HTMLButtonElement) || !(close instanceof HTMLButtonElement) || !(back instanceof HTMLElement)) return;
    const setOpen = (value: boolean) => {
      card.classList.toggle('is-open', value);
      open.setAttribute('aria-expanded', String(value));
      back.setAttribute('aria-hidden', String(!value));
      if (value) close.focus(); else open.focus();
    };
    open.addEventListener('click', () => setOpen(true));
    close.addEventListener('click', () => setOpen(false));
    card.addEventListener('keydown', (event) => { if (event instanceof KeyboardEvent && event.key === 'Escape' && card.classList.contains('is-open')) setOpen(false); });
  });
</script>

<style>
  .case-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px;margin-top:42px}.case-card{min-height:640px;perspective:1600px}.case-inner{position:relative;height:100%;min-height:640px;transition:transform .65s cubic-bezier(.2,.75,.25,1);transform-style:preserve-3d}.case-card.is-open .case-inner{transform:rotateY(180deg)}@media(hover:hover) and (pointer:fine){.case-card.is-flippable:hover .case-inner{transform:rotateY(180deg)}.case-card.is-flippable:hover .case-back{pointer-events:auto}}.case-face{overflow:hidden;border:1px solid var(--color-line);border-radius:28px;background:#fff;backface-visibility:hidden}.case-front{height:100%}.case-front img{width:100%;aspect-ratio:16/10;object-fit:contain;background:#fff}.case-copy{padding:26px}.kicker{color:var(--color-brand);font-size:.78rem;font-weight:850;letter-spacing:.03em}.case-face h3{margin:8px 0;font-size:1.45rem}.case-face p{color:var(--color-muted)}.case-copy aside{margin-top:20px;padding:18px;border-radius:16px;background:rgba(165,145,92,.12);color:var(--color-dark-green);font-size:.9rem;line-height:1.7}.case-copy aside b{display:block;margin-bottom:5px;color:var(--color-ink)}button{min-height:44px;font:inherit}.flip-button{display:flex;width:100%;align-items:center;justify-content:space-between;margin-top:18px;padding:11px 16px;border:0;border-radius:14px;background:var(--color-ink);color:#fff;font-weight:750;cursor:pointer}.flip-button span{font-size:1.25rem}.case-back{position:absolute;inset:0;display:flex;flex-direction:column;padding:24px;transform:rotateY(180deg);pointer-events:none}.case-card.is-open .case-back{pointer-events:auto}.back-top{display:flex;align-items:start;justify-content:space-between;gap:16px}.back-top h3{margin-top:5px}.close-button{width:44px;border:1px solid var(--color-line);border-radius:50%;background:#fff;color:var(--color-ink);font-size:1.5rem;cursor:pointer}.expense-list{margin:18px 0;padding:15px 18px;border:1px solid rgba(31,120,173,.16);border-radius:18px;background:rgba(31,120,173,.045)}.expense-list div{display:flex;justify-content:space-between;gap:16px;padding:7px 0}.expense-list dt{color:var(--color-muted)}.expense-list dd{margin:0;color:var(--color-ink);font-weight:850}.expense-list dd.accent{color:var(--color-brand)}.benefit-compare{display:grid;grid-template-columns:.8fr 1.35fr;gap:10px}.benefit-compare section{padding:16px;border:1px solid var(--color-line);border-radius:18px;background:rgba(51,61,71,.045)}.benefit-compare section.insured{border-color:rgba(211,17,69,.2);background:rgba(211,17,69,.035)}.benefit-compare h4{margin:0 0 10px;font-size:.9rem}.benefit-compare ul{margin:0;padding-left:18px;color:var(--color-muted);font-size:.8rem;line-height:1.65}.benefit-compare strong{display:block;margin-top:12px;color:var(--color-brand);font-size:1.25rem}.benefit-compare small{display:block;margin-top:5px;color:var(--color-muted)}.claim-highlight{margin:14px 0 0;padding:13px 15px;border-radius:14px;background:#1f78ad;color:#fff!important;font-size:.85rem;font-weight:750;line-height:1.55}.calculation-note{margin:auto 0 0;padding-top:12px;font-size:.68rem;line-height:1.5}@media(max-width:900px){.case-grid{grid-template-columns:1fr}.case-card,.case-inner{min-height:660px}}@media(max-width:560px){.case-card,.case-inner{min-height:720px}.case-face{border-radius:22px}.case-copy,.case-back{padding:20px}.benefit-compare{grid-template-columns:1fr}.case-front img{aspect-ratio:16/9}}
</style>
